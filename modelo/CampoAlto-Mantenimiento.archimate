      <element xsi:type="archimate:Representation" name="«Visto bueno»" id="rp-visto"/>
      <element xsi:type="archimate:Representation" name="«Firma»" id="rp-firma"/>
      <element xsi:type="archimate:Representation" name="«Sale condicionado»" id="rp-cond"/>
      <element xsi:type="archimate:Representation" name="«Frenado»" id="rp-frenado"/>
      <element xsi:type="archimate:Representation" name="«Lista de las cinco»" id="rp-lista"/>
      <element xsi:type="archimate:Representation" name="«Preventivo»" id="rp-preventivo"/>
      <element xsi:type="archimate:Representation" name="«Probeta»" id="rp-probeta"/>
      <element xsi:type="archimate:Representation" name="«De a par»" id="rp-par"/>
      <element xsi:type="archimate:Representation" name="«Canibalizar»" id="rp-canibal"/>
      <element xsi:type="archimate:Representation" name="«Baja»" id="rp-baja"/>
      <element xsi:type="archimate:Representation" name="«Media carga»" id="rp-media"/>
