<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:canvas="http://www.archimatetool.com/archimate/canvas" name="CampoAlto - Mantenimiento de la flota" id="id-campoalto" version="5.0.0">
  <folder name="Strategy" id="id-folder-strategy" type="strategy">
    <folder name="V2 Mapa de capacidades" id="id-fld-strategy-2">
      <element xsi:type="archimate:Capability" name="Dirección y planeación" id="cap1-dir">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Planear la flota por campaña" id="cap-campana">
        <documentation>Caña todo el año en el Valle; arroz por campaña en Tolima.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Abrir y cerrar bases por campaña" id="cap-bases">
        <documentation>Espinal se arma con la campaña de arroz; el contenedor se queda.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Comercialización" id="cap1-com">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Vender la hectárea fumigada" id="cap-vender">
        <documentation>El cliente paga la hectárea aplicada, no el mantenimiento.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Atender ingenios y arroceros" id="cap-clientes">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Responder reclamos de dosis o franjas" id="cap-reclamo">
        <documentation>Operaciones manda el resumen de la misión; el taller adjunta la última probeta.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Programación de la operación" id="cap1-prog">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Prometer el lote al cliente" id="cap-prometer">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Armar finca, piloto y dron con la lista" id="cap-armar">
        <documentation>Recibe la lista de las cinco.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Correr o cubrir un lote" id="cap-correr">
        <documentation>Avisa los lotes corridos por el taller.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Ubicar los equipos en campo" id="cap-ubicar">
        <documentation>FlightHub; el taller no lo usa.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Ejecución de la fumigación" id="cap1-vuelo">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Hacer el pre-vuelo" id="cap-prevuelo">
        <documentation>Si falla lo crítico, el dron vuelve a orden.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Aplicar el producto en el lote" id="cap-aplicar">
        <documentation>La dosis la pone el agrónomo del cliente.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Lavar tanque y mangueras" id="cap-lavar">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Reportar la novedad de campo" id="cap-novedad">
        <documentation>Número, qué pasó y una foto en «Novedades campo».</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Seguridad aeronáutica" id="cap1-seg">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Sostener registro y póliza" id="cap-registro">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Certificar pilotos RPAS" id="cap-rpas">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Mantener el manual de operaciones" id="cap-manual">
        <documentation>De ahí salen la revisión de 50 h y la visita de motor.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Armar el expediente ante la Aeronáutica" id="cap-expediente">
        <documentation>Seguridad lo manda; el taller ordena la carpeta.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Avisar frenos por papeles o incidente" id="cap-avisarfreno">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión financiera" id="cap1-fin">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Facturar hectáreas en Siigo" id="cap-facturar">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Contabilizar compras de repuesto" id="cap-contabilizar">
        <documentation>El costo vuelve solo si administración abre la factura.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Talento humano" id="cap1-th">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Vincular pilotos por temporada" id="cap-pilotos">
        <documentation>Unos 16 en temporada baja y 28 en la alta.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Asignar técnicos por puesto y base" id="cap-puestos">
        <documentation>El alcance de la firma es el puesto.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Tecnología e información" id="cap1-ti">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Leer la telemetría del Agras" id="cap-telemetria">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Comunicar por grupos de WhatsApp" id="cap-grupos">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Identificar cada dron por número, modelo y serial" id="cap-identificar">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Logística y bases" id="cap1-log">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Custodiar baterías en el cuarto" id="cap-cuarto">
        <documentation>Separado del químico; la batería no se deja en la camioneta al sol.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Transportar equipos en camioneta" id="cap-transportar">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Devolver drones y baterías a Palmira al cerrar campaña" id="cap-retorno">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Devolver canecas vacías con la cuadrilla" id="cap-canecas">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Abastecimiento de repuestos" id="cap1-rep">
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Pedir la pieza por nombre y modelo" id="cap-pedir">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Mantener la estantería y los kits de línea" id="cap-estanteria">
        <documentation>La existencia se ve; no hay kárdex.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Comprar y registrar la factura" id="cap-comprar">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Colinda: entrega o recibe un dato"/>
      </element>
      <element xsi:type="archimate:Capability" name="Tramitar la garantía con el distribuidor" id="cap-garantia">
        <documentation>No suelta el vuelo.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="No la toca la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Mantenimiento de la flota" id="cap1-mant">
        <documentation>Capacidad de apoyo, como el mantenimiento biomédico del mapa de la IPS: el cliente compra la fumigación, no el mantenimiento. Es la capacidad que se desglosa en servicios en V4.</documentation>
        <property key="Nivel" value="1"/>
      </element>
      <element xsi:type="archimate:Capability" name="Llevar las horas" id="cap-horas">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Planear la revisión de 50 h y la visita de motor" id="cap-plan">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Intervenir por subsistema" id="cap-int">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Cuidar las baterías" id="cap-bat">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Retener por boletín o papeles" id="cap-ret">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Soltar el vuelo" id="cap-soltar">
        <documentation>La decisión que no puede fallar.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Publicar la disponibilidad" id="cap-pub">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Capability" name="Medir el día del taller" id="cap-medir">
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Apoyo"/>
        <property key="Impacto" value="Soportada por la solución"/>
      </element>
      <element xsi:type="archimate:Resource" name="16 Agras T50 y 8 Agras T40" id="rs-flota"/>
      <element xsi:type="archimate:Resource" name="54 baterías de T50 y 30 de T40" id="rs-bat"/>
      <element xsi:type="archimate:Resource" name="Taller de Palmira y bases de Buga y Espinal" id="rs-bases"/>
      <element xsi:type="archimate:Resource" name="Cinco técnicos en Palmira y técnicos de línea en las bases" id="rs-tec"/>
      <element xsi:type="archimate:Resource" name="App del Agras en el control remoto" id="rs-app"/>
      <element xsi:type="archimate:Resource" name="Estantería de Palmira y kits de línea" id="rs-estante"/>
      <element xsi:type="archimate:CourseOfAction" name="Revisar a las 50 h y visitar el motor a las 200 h o seis meses" id="ca-primero"/>
      <element xsi:type="archimate:CourseOfAction" name="Una sola orden por entrada" id="ca-orden"/>
      <element xsi:type="archimate:CourseOfAction" name="Soltar lo crítico solo con visto bueno del jefe" id="ca-visto"/>
      <element xsi:type="archimate:CourseOfAction" name="Dejar el indicador en blanco si falta el dato" id="ca-cero"/>
      <element xsi:type="archimate:CourseOfAction" name="Pedir por nombre y modelo, sin código de bodega" id="ca-nombre"/>
    </folder>
    <folder name="V3 Cadena de valor" id="id-fld-strategy-3">
      <element xsi:type="archimate:ValueStream" name="Fumigación por hectárea" id="vs-fum">
        <documentation>Cadena de valor de CampoAlto. El cliente paga la hectárea aplicada.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Vender la hectárea" id="vs-vender"/>
      <element xsi:type="archimate:ValueStream" name="Programar el lote" id="vs-programar"/>
      <element xsi:type="archimate:ValueStream" name="Alistar la flota" id="vs-alistar"/>
      <element xsi:type="archimate:ValueStream" name="Fumigar el lote" id="vs-fumigar"/>
      <element xsi:type="archimate:ValueStream" name="Facturar las hectáreas" id="vs-facturar"/>
    </folder>
  </folder>
  <folder name="Business" id="id-folder-business" type="business">
    <folder name="V3 Proceso E2E" id="id-fld-business-4">
      <element xsi:type="archimate:BusinessActor" name="Jefe de mantenimiento" id="act-jefe"/>
      <element xsi:type="archimate:BusinessActor" name="Técnico de línea" id="act-linea">
        <documentation>Uno en Buga y uno en Espinal (dos en campaña). Hélice, boquilla, filtro, lavado, apriete y probeta.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Técnicos de Palmira" id="act-esp">
        <documentation>Dos de estructura y motores, uno de baterías, uno de bombas y circuito de líquido, uno de electrónica.</documentation>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Piloto" id="act-piloto"/>
      <element xsi:type="archimate:BusinessActor" name="Coordinador de operaciones" id="act-coord"/>
      <element xsi:type="archimate:BusinessActor" name="Responsable de seguridad" id="act-seg"/>
      <element xsi:type="archimate:BusinessActor" name="Comercial" id="act-com"/>
      <element xsi:type="archimate:BusinessProcess" name="Devolver el dron a disponible" id="p-e2e">
        <documentation>Proceso de punta a punta de la tarde: del regreso a la base a la lista de las cinco.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Recibir el dron" id="p-rec"/>
      <element xsi:type="archimate:BusinessProcess" name="Anotar un solo total de horas" id="p-hor"/>
      <element xsi:type="archimate:BusinessProcess" name="Decidir verde u orden" id="p-dec"/>
      <element xsi:type="archimate:BusinessProcess" name="Intervenir" id="p-int"/>
      <element xsi:type="archimate:BusinessProcess" name="Cerrar el trabajo del técnico" id="p-cie"/>
      <element xsi:type="archimate:BusinessProcess" name="Dar el visto bueno" id="p-vis"/>
      <element xsi:type="archimate:BusinessProcess" name="Publicar la lista" id="p-pub"/>
      <element xsi:type="archimate:BusinessProcess" name="Retener por boletín o papeles" id="p-ret"/>
      <element xsi:type="archimate:BusinessProcess" name="Hacer el pre-vuelo" id="p-pre">
        <documentation>A la madrugada, ya asignado. No es un paso de dejar el dron disponible.</documentation>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Asignar finca, piloto y dron" id="p-asig">
        <documentation>Lo hace el coordinador con la lista publicada.</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Jornada cerrada" id="ev-jornada"/>
      <element xsi:type="archimate:BusinessEvent" name="Síntoma o daño" id="ev-sintoma"/>
      <element xsi:type="archimate:BusinessEvent" name="Se cumplieron 50 h, 200 h o seis meses" id="ev-50"/>
      <element xsi:type="archimate:BusinessEvent" name="Boletín o mensaje de seguridad" id="ev-boletin"/>
      <element xsi:type="archimate:BusinessEvent" name="Pre-vuelo fallido" id="ev-prevuelo"/>
      <element xsi:type="archimate:BusinessEvent" name="Lista publicada" id="ev-lista"/>
    </folder>
    <folder name="V4 Roles y funciones" id="id-fld-business-6">
      <element xsi:type="archimate:BusinessRole" name="Firmante de línea" id="role-linea">
        <documentation>Cierra hélice, boquilla, filtro y lavado y puede dejar el verde.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Firmante del subsistema" id="role-sub">
        <documentation>Firma solo el subsistema de su puesto: motores, bombas o electrónica.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Responsable de baterías" id="role-bat">
        <documentation>Aparta, cuenta y propone la baja. No la firma.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Suelta el vuelo y publica la lista" id="role-vuelo">
        <documentation>Lo ejerce el jefe de mantenimiento.</documentation>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Planea y abastece el taller" id="role-plan">
        <documentation>Lo ejerce el jefe de mantenimiento.</documentation>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Recibir y clasificar el dron" id="fn-recibir"/>
      <element xsi:type="archimate:BusinessFunction" name="Reconciliar las horas" id="fn-reconciliar"/>
      <element xsi:type="archimate:BusinessFunction" name="Reparar y firmar por subsistema" id="fn-reparar"/>
      <element xsi:type="archimate:BusinessFunction" name="Cuidar las baterías" id="fn-baterias"/>
      <element xsi:type="archimate:BusinessFunction" name="Soltar lo crítico" id="fn-soltar"/>
      <element xsi:type="archimate:BusinessFunction" name="Obedecer los frenos" id="fn-frenos"/>
      <element xsi:type="archimate:BusinessFunction" name="Publicar la lista de las cinco" id="fn-publicar"/>
      <element xsi:type="archimate:BusinessFunction" name="Programar las revisiones" id="fn-planear"/>
      <element xsi:type="archimate:BusinessFunction" name="Pedir las piezas" id="fn-pedir"/>
      <element xsi:type="archimate:BusinessFunction" name="Contar el día" id="fn-contar"/>
    </folder>
    <folder name="V4 Servicios" id="id-fld-business-7">
      <element xsi:type="archimate:BusinessService" name="Cierre de jornada" id="bs-cierre">
        <documentation>Recibe el dron, fija un solo total y decide verde u orden.</documentation>
        <property key="Capa" value="Servicio de negocio de plataforma"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Mantenimiento por subsistema" id="bs-mant">
        <documentation>Abre la orden, absorbe el hallazgo y cierra con la firma de quien hizo el trabajo.</documentation>
        <property key="Capa" value="Servicio de negocio de plataforma"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Liberación del vuelo" id="bs-lib">
        <documentation>Pasa a verde lo crítico con el visto bueno, marca el condicionado y respeta los frenos.</documentation>
        <property key="Capa" value="Servicio de negocio de plataforma"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Publicación de la disponibilidad" id="bs-pub">
        <documentation>Arma y publica la lista de las cinco hacia operaciones.</documentation>
        <property key="Capa" value="Servicio de negocio de plataforma"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión de horas de vuelo" id="ds-horas">
        <property key="Capa" value="Servicio de dominio"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión del plan y el despiece" id="ds-plan">
        <property key="Capa" value="Servicio de dominio"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión de órdenes de trabajo" id="ds-ot">
        <property key="Capa" value="Servicio de dominio"/>
      </element>
