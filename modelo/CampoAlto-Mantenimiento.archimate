    <folder name="4 Agregados, comandos y eventos" id="id-fld-views-4">
      <element xsi:type="archimate:ArchimateDiagramModel" name="V6a Agregados · Soltar el vuelo" id="id-v6a">
        <documentation>Agregado: raíz, entidades, objetos de valor e invariantes; comandos que lo cambian y eventos que emite (DDD, diapositivas 16 a 24). A la izquierda lo que lo dispara desde otro agregado; a la derecha a quién dispara.</documentation>
        <child xsi:type="archimate:DiagramObject" id="id-v6a-n001" fillColor="#f7fbff" textAlignment="1" archimateElement="g-agg-do-disp">
          <bounds x="330" y="20" width="946" height="763"/>
