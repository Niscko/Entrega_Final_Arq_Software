<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CampoAlto - Mantenimiento de la flota" id="id-campoalto" version="5.0.0">
  <folder name="Strategy" id="id-folder-strategy" type="strategy">
    <element xsi:type="archimate:Capability" name="Comercializar la fumigación · fuera" id="id-cap-com" />
    <element xsi:type="archimate:Capability" name="Facturar hectáreas · fuera" id="id-cap-fac" />
    <element xsi:type="archimate:Capability" name="Programar la operación · colinda" id="id-cap-prog" />
    <element xsi:type="archimate:Capability" name="Armar finca, piloto y dron · fuera" id="id-cap-armar" />
    <element xsi:type="archimate:Capability" name="Recibir la lista de disponibles · colinda" id="id-cap-listaop" />
    <element xsi:type="archimate:Capability" name="Ejecutar la fumigación · colinda" id="id-cap-vuelo" />
    <element xsi:type="archimate:Capability" name="Pre-vuelo · fuera" id="id-cap-pre" />
    <element xsi:type="archimate:Capability" name="Reportar la novedad · colinda" id="id-cap-nov" />
    <element xsi:type="archimate:Capability" name="Mantener la flota para salir · entra" id="id-cap-mant" />
    <element xsi:type="archimate:Capability" name="Llevar las horas · entra" id="id-cap-horas" />
    <element xsi:type="archimate:Capability" name="Intervenir por subsistema · entra" id="id-cap-int" />
    <element xsi:type="archimate:Capability" name="Soltar el vuelo · entra" id="id-cap-soltar" />
    <element xsi:type="archimate:Capability" name="Publicar la lista · entra" id="id-cap-pub" />
    <element xsi:type="archimate:Capability" name="Abastecer el repuesto · colinda" id="id-cap-rep" />
    <element xsi:type="archimate:Capability" name="Pedir por nombre y modelo · entra" id="id-cap-pedir" />
    <element xsi:type="archimate:Capability" name="Existencia y factura en Siigo · fuera" id="id-cap-stock" />
    <element xsi:type="archimate:Capability" name="Sostener el permiso de volar · colinda" id="id-cap-perm" />
    <element xsi:type="archimate:Capability" name="Registro y póliza · fuera" id="id-cap-pol" />
    <element xsi:type="archimate:Capability" name="Frenar si seguridad avisa · entra" id="id-cap-freno" />
    <element xsi:type="archimate:Capability" name="Definir dosis y producto · fuera" id="id-cap-quim" />
    <element xsi:type="archimate:Resource" name="16 T50 y 8 T40, baterías 54 y 30" id="id-rs-flota" />
    <element xsi:type="archimate:Resource" name="Taller Palmira y bases Buga y Espinal" id="id-rs-bases" />
    <element xsi:type="archimate:Resource" name="App del Agras y estantería" id="id-rs-app" />
    <element xsi:type="archimate:CourseOfAction" name="Crítico solo con visto bueno del jefe" id="id-ca-visto" />
    <element xsi:type="archimate:CourseOfAction" name="200 h o seis meses, lo que ocurra primero" id="id-ca-primero" />
    <element xsi:type="archimate:CourseOfAction" name="Dejar el indicador en blanco si falta el dato" id="id-ca-cero" />
    <element xsi:type="archimate:ValueStream" name="Devolver el dron a disponible" id="id-vs" />
    <element xsi:type="archimate:ValueStream" name="Regreso a la base" id="id-vs1" />
    <element xsi:type="archimate:ValueStream" name="Horas y decisión" id="id-vs2" />
    <element xsi:type="archimate:ValueStream" name="Intervención y visto bueno" id="id-vs3" />
    <element xsi:type="archimate:ValueStream" name="Lista antes de las cinco" id="id-vs4" />
  </folder>
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Jefe de mantenimiento" id="id-act-jefe" />
    <element xsi:type="archimate:BusinessActor" name="Técnico de línea" id="id-act-linea" />
    <element xsi:type="archimate:BusinessActor" name="Técnicos de Palmira" id="id-act-esp">
      <documentation>Dos de motores, uno de baterías, uno de bombas, uno de electrónica.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Piloto" id="id-act-piloto" />
    <element xsi:type="archimate:BusinessActor" name="Coordinador de operaciones" id="id-act-coord" />
    <element xsi:type="archimate:BusinessActor" name="Responsable de seguridad" id="id-act-seg" />
    <element xsi:type="archimate:BusinessProcess" name="Recibir el dron" id="id-p-rec" />
    <element xsi:type="archimate:BusinessProcess" name="Anotar un solo total de horas" id="id-p-hor" />
    <element xsi:type="archimate:BusinessProcess" name="Decidir verde u orden" id="id-p-dec" />
    <element xsi:type="archimate:BusinessProcess" name="Intervenir" id="id-p-int" />
    <element xsi:type="archimate:BusinessProcess" name="Cerrar el trabajo del técnico" id="id-p-cie" />
    <element xsi:type="archimate:BusinessProcess" name="Dar el visto bueno" id="id-p-vis" />
    <element xsi:type="archimate:BusinessProcess" name="Publicar la lista" id="id-p-pub" />
    <element xsi:type="archimate:BusinessProcess" name="Retener por boletín o papeles" id="id-p-ret" />
    <element xsi:type="archimate:BusinessProcess" name="Pre-vuelo (fuera de este camino)" id="id-p-pre" />
    <element xsi:type="archimate:BusinessProcess" name="Asignar la finca (fuera)" id="id-p-asig" />
    <element xsi:type="archimate:BusinessEvent" name="Jornada cerrada" id="id-ev-j" />
    <element xsi:type="archimate:BusinessEvent" name="50 h, 200 h o seis meses" id="id-ev-50" />
    <element xsi:type="archimate:BusinessEvent" name="Síntoma o daño" id="id-ev-sin" />
    <element xsi:type="archimate:BusinessEvent" name="Boletín o mensaje de seguridad" id="id-ev-bol" />
    <element xsi:type="archimate:BusinessEvent" name="Pre-vuelo fallido" id="id-ev-pre" />
    <element xsi:type="archimate:BusinessEvent" name="Lista publicada" id="id-ev-lista" />
    <element xsi:type="archimate:BusinessService" name="Cerrar la jornada" id="id-bs-cerrar">
      <documentation>Capa de proceso. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Publicar disponibilidad" id="id-bs-pub">
      <documentation>Capa de proceso. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Registrar las horas" id="id-bs-horas">
      <documentation>Capa de tarea. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Llevar la orden de trabajo" id="id-bs-ot">
      <documentation>Capa de tarea. Dentro. El hallazgo se agrega en la misma orden.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Cumplir 50 h y visita de motor" id="id-bs-plan">
      <documentation>Capa de tarea. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Emitir el visto bueno" id="id-bs-visto">
      <documentation>Capa de tarea. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Retener el dron" id="id-bs-ret">
      <documentation>Capa de tarea. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Decidir la baja de la batería" id="id-bs-baja">
      <documentation>Capa de tarea. Dentro. No es automática.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Dron y despiece" id="id-bs-dron">
      <documentation>Capa de entidad. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Orden de trabajo" id="id-bs-orden">
      <documentation>Capa de entidad. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Lista del día" id="id-bs-lista">
      <documentation>Capa de entidad. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="No publicar cero" id="id-bs-cero">
      <documentation>Capa de utilidad. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Reloj de horas y de seis meses" id="id-bs-reloj">
      <documentation>Capa de utilidad. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Traducir la lectura del Agras" id="id-bs-agras">
      <documentation>Anticorrupción. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Entregar la lista a operaciones" id="id-bs-out">
      <documentation>Anticorrupción. Dentro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Pedir pieza por nombre y modelo" id="id-bs-ped">
      <documentation>Anticorrupción. Dentro. Sin código de bodega.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recibir freno de seguridad o boletín" id="id-bs-seg">
      <documentation>Anticorrupción. Dentro. Sin portal.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Programar la finca" id="id-x-finca">
      <documentation>Fuera de alcance. Lo hace el coordinador. A él le basta número, si sale y el límite.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Facturar hectáreas" id="id-x-fact">
      <documentation>Fuera de alcance. Comercial, en Siigo, después del vuelo. La factura no suelta el dron.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consultar FlightHub" id="id-x-fh">
      <documentation>Fuera de alcance. Operaciones mira la ubicación. El taller no lo usa para horas ni disponibilidad.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Radicar en el portal" id="id-x-port">
      <documentation>Fuera de alcance. Cerrar la orden no radica nada. Lo arma seguridad, aparte.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Revisar dosis e ICA" id="id-x-ica">
      <documentation>Fuera de alcance. La dosis la pone el agrónomo. No entra al verde.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consultar habilitación" id="id-x-hab">
      <documentation>Fuera de alcance. No existe ese registro. El alcance es el puesto.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Existencia automática" id="id-x-stock">
      <documentation>Fuera de alcance. La existencia se ve en la estantería o la dice la base. Siigo no la devuelve.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Actualizar firmware" id="id-x-fw">
      <documentation>Fuera de alcance. Lo hace el técnico si el jefe autorizó. El software no lo instala.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Abrir la garantía" id="id-x-gar">
      <documentation>Fuera de alcance. El preventivo no abre la garantía. El trámite no suelta el vuelo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Baja automática de batería" id="id-x-baja">
      <documentation>Fuera de alcance. A los 500 ciclos se propone. La baja la firma el jefe.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Cruzar pieza T40/T50" id="id-x-cruce">
      <documentation>Fuera de alcance. El repuesto no se cruza. El T50 no sale con una sola bomba.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Hacer el pre-vuelo" id="id-x-pre">
      <documentation>Fuera de alcance. Es de la madrugada, ya asignado. Si falla lo crítico, el dron vuelve a orden.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato cierre de jornada" id="id-ct-cerrar">
      <documentation>Entra: número, horas de la pantalla o de la hoja ya corregida, síntoma y foto si hay. Sale: verde o en OT.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de la lista" id="id-ct-pub">
      <documentation>Número, sale o condicionado o no sale, límite si condicionado, motivo en una línea. Sin despiece y sin póliza.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de horas" id="id-ct-horas">
      <documentation>Un solo total. Origen: pantalla, o app si la supera en 10 h o más, o la hoja si la misión quedó abierta. Sin hectáreas.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de la orden" id="id-ct-ot">
      <documentation>Consecutivo del año, motivo de entrada, líneas con serial, un solo número de horas. El hallazgo no abre otro papel.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del plan" id="id-ct-plan">
      <documentation>50 h al cerrar la jornada en que se cumplen. Visita de motor a las 200 h o a los seis meses, lo primero. No corta el lote empezado.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del visto bueno" id="id-ct-visto">
      <documentation>Número, orden, subsistema crítico y decisión del jefe. Sin este contrato el coordinador no arma la finca.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de retención" id="id-ct-ret">
      <documentation>Mensaje de seguridad o boletín, seriales que coinciden y efecto: frena ya o espera a la de 50 h.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de baja" id="id-ct-baja">
      <documentation>La decide el jefe. Excepción de más de 500 ciclos: pico de arroz, sin hinchazón, celdas parejas, lote cerca de carretera.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del dron" id="id-ct-dron">
      <documentation>Número, modelo T40 o T50, piezas montadas del mismo modelo.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato expediente de orden" id="id-ct-orden">
      <documentation>Papel o foto. Si no queda ninguno, el servicio no se inventa: se vuelve a hacer.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato lista guardada" id="id-ct-lista">
      <documentation>El conteo de las 17:00 se guarda. No se inventa el promedio del mes.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato sin cero" id="id-ct-cero">
      <documentation>Si falta costo o no se contaron fallas, el indicador queda vacío. Cero no se escribe.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del reloj" id="id-ct-reloj">
      <documentation>Horas desde la última de 50. Fecha de la última visita de motor.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato lectura Agras" id="id-ct-agras">
      <documentation>Horas, caudal, alerta y ciclos si esa pantalla se abrió. No llegan solos a la hoja. FlightHub no entra.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato hacia operaciones" id="id-ct-out">
      <documentation>Lo mismo que la lista. Ellos devuelven finca, piloto, dron y si un lote se corrió. Eso no suelta un dron.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del pedido" id="id-ct-ped">
      <documentation>Nombre y modelo: bomba de T50, par de hélice de T50. No hay código de bodega ni kit de intervención.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato del freno" id="id-ct-seg">
      <documentation>Este dron no sale, por registro, póliza o incidente. El taller no consulta la póliza por su cuenta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Estado del dron" id="id-bo-estado">
      <documentation>Verde, en OT, pendiente de visto bueno, sale condicionado, frenado.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Total de horas de la hoja" id="id-bo-horas" />
    <element xsi:type="archimate:BusinessObject" name="Orden de trabajo" id="id-bo-orden" />
    <element xsi:type="archimate:BusinessObject" name="Batería" id="id-bo-bat" />
    <element xsi:type="archimate:BusinessObject" name="Lote prometido" id="id-bo-prom">
      <documentation>El coordinador ya le dijo al cliente que entra. No es la factura.</documentation>
    </element>
    <element xsi:type="archimate:Representation" name="«Disponible» en la lista de las cinco" id="id-rp-disp" />
    <element xsi:type="archimate:Representation" name="«Disponible» como ubicación" id="id-rp-fh" />
    <element xsi:type="archimate:Representation" name="Total escrito en la hoja" id="id-rp-hoja" />
    <element xsi:type="archimate:Representation" name="Horas en el WhatsApp del piloto" id="id-rp-msg" />
    <element xsi:type="archimate:Representation" name="Firma en el papel" id="id-rp-firma" />
    <element xsi:type="archimate:Representation" name="Mensaje en el grupo Programa" id="id-rp-visto" />
    <element xsi:type="archimate:Representation" name="Encabezado 50 h o visita de motor" id="id-rp-prev" />
    <element xsi:type="archimate:Representation" name="Hallazgo que retiene" id="id-rp-falla" />
    <element xsi:type="archimate:Representation" name="Baja firmada por el jefe" id="id-rp-baja" />
    <element xsi:type="archimate:Representation" name="Guardada a media carga" id="id-rp-media" />
    <element xsi:type="archimate:Representation" name="Copia del registro detrás de las órdenes" id="id-rp-reg" />
    <element xsi:type="archimate:Representation" name="Carpeta física del dron" id="id-rp-carp" />
    <element xsi:type="archimate:Representation" name="El lote ya fue prometido" id="id-rp-prom" />
    <element xsi:type="archimate:Representation" name="Factura de hectáreas en Siigo" id="id-rp-fac" />
    <element xsi:type="archimate:BusinessObject" name="Disponibilidad del dron" id="id-ag-disp">
      <documentation>No queda en verde con orden crítica abierta. Esos cuatro subsistemas esperan al jefe. Con las 50 h cumplidas no hay jornada nueva. Hacen falta dos baterías sanas. Condicionado solo el carenado que no toca hélice ni tanque.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Estado" id="id-ag-disp-0" />
    <element xsi:type="archimate:BusinessObject" name="Horas desde la 50" id="id-ag-disp-1" />
    <element xsi:type="archimate:BusinessObject" name="Fecha de visita de motor" id="id-ag-disp-2" />
    <element xsi:type="archimate:BusinessObject" name="Baterías sanas del modelo" id="id-ag-disp-3" />
    <element xsi:type="archimate:BusinessObject" name="Límite condicionado" id="id-ag-disp-4" />
    <element xsi:type="archimate:BusinessObject" name="Orden de trabajo" id="id-ag-ot">
      <documentation>Una entrada, una orden. Un solo número de horas. La firma crítica no pone verde. El de línea no firma motor, baja ni electrónica. Canibalizar solo desde un dron que ya está en orden, con autorización del jefe, y en las dos órdenes. Sin papel ni foto el servicio se vuelve a hacer.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Línea de intervención" id="id-ag-ot-0" />
    <element xsi:type="archimate:BusinessObject" name="Serial de la pieza" id="id-ag-ot-1" />
    <element xsi:type="archimate:BusinessObject" name="Motivo de entrada" id="id-ag-ot-2" />
    <element xsi:type="archimate:BusinessObject" name="Horas anotadas" id="id-ag-ot-3" />
    <element xsi:type="archimate:BusinessObject" name="Par de hélice o boquilla" id="id-ag-ot-4" />
    <element xsi:type="archimate:BusinessObject" name="Total de horas" id="id-ag-horas">
      <documentation>No se suman piloto y app. Diez horas o más por encima: manda la app. App por debajo porque no cerraron la misión: manda la hoja. FlightHub no entra.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Lectura de pantalla" id="id-ag-horas-0" />
    <element xsi:type="archimate:BusinessObject" name="Lectura de la app" id="id-ag-horas-1" />
    <element xsi:type="archimate:BusinessObject" name="Mensaje del piloto" id="id-ag-horas-2" />
    <element xsi:type="archimate:BusinessObject" name="Batería" id="id-ag-bat">
      <documentation>No se da de baja sola. La del T50 no entra en el T40. Quieta más de siete días no es baja. Sobre 500 ciclos solo con autorización, sin hinchazón, celdas parejas y lote cerca de carretera.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Modelo" id="id-ag-bat-0" />
    <element xsi:type="archimate:BusinessObject" name="Ciclos" id="id-ag-bat-1" />
    <element xsi:type="archimate:BusinessObject" name="Alerta o hinchazón" id="id-ag-bat-2" />
    <element xsi:type="archimate:BusinessObject" name="Observación de las cinco" id="id-ag-ind">
      <documentation>Disponible es quien puede entrar mañana, en el aire o sobrando en tierra. No es el mediodía en FlightHub. El preventivo a tiempo no es falla. Si falta el dato, no se escribe cero.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Disponibles" id="id-ag-ind-0" />
    <element xsi:type="archimate:BusinessObject" name="Lotes corridos por el taller" id="id-ag-ind-1" />
    <element xsi:type="archimate:BusinessObject" name="Fallos de pre-vuelo" id="id-ag-ind-2" />
    <element xsi:type="archimate:BusinessObject" name="Espera de Bogotá" id="id-ag-ind-3" />
    <element xsi:type="archimate:BusinessObject" name="Retención" id="id-ag-ret">
      <documentation>El taller no radica y no entra al portal. Un comentario de otro operador no para la flota. Si no hay papel ni foto, no se inventa el servicio.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Mensaje de seguridad" id="id-ag-ret-0" />
    <element xsi:type="archimate:BusinessObject" name="Boletín y seriales" id="id-ag-ret-1" />
    <element xsi:type="archimate:BusinessObject" name="Carpeta" id="id-ag-ret-2" />
    <element xsi:type="archimate:BusinessObject" name="Pedido de repuesto" id="id-ag-ped">
      <documentation>Sin código de bodega. Siigo no devuelve existencia. Si la pieza no está, el dron no sale aunque el lote esté prometido. La garantía no suelta el vuelo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Nombre y modelo" id="id-ag-ped-0" />
    <element xsi:type="archimate:BusinessObject" name="Aviso de llegada" id="id-ag-ped-1" />
    <element xsi:type="archimate:BusinessObject" name="Costo si lo pasan" id="id-ag-ped-2" />
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Soltar el vuelo" id="id-cmp-soltar">
      <documentation>Dominio central. Único que pasa a verde un motor, una bomba, una batería o la electrónica.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Intervención y orden" id="id-cmp-ot">
      <documentation>Soporte del central. Cierra el trabajo. No pone el verde crítico.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Horas de vuelo" id="id-cmp-horas">
      <documentation>Soporte. Aplica la regla de una sola cifra.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Baterías" id="id-cmp-bat">
      <documentation>Soporte. Aparta y propone. No da de baja sola.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Indicadores del día" id="id-cmp-ind">
      <documentation>Soporte. Cuenta quien puede entrar mañana. No publica cero.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Retención y expediente" id="id-cmp-ret">
      <documentation>Soporte. Obedece el mensaje. No entra al portal.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Pedido de repuesto" id="id-cmp-ped">
      <documentation>Soporte. Pide por nombre y modelo. No inventa existencia.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Identidad T40/T50" id="id-cmp-id">
      <documentation>Genérico. Número, modelo y serial. Lo comparten los demás.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="App del Agras (externa)" id="id-ext-agras" />
    <element xsi:type="archimate:ApplicationComponent" name="Canal de programación (externo)" id="id-ext-prog" />
    <element xsi:type="archimate:ApplicationComponent" name="Novedades de campo (externo)" id="id-ext-piloto" />
    <element xsi:type="archimate:ApplicationComponent" name="Siigo (externo)" id="id-ext-siigo" />
    <element xsi:type="archimate:ApplicationComponent" name="Distribuidor de Bogotá (externo)" id="id-ext-dist" />
    <element xsi:type="archimate:ApplicationComponent" name="Mensaje de seguridad (externo)" id="id-ext-seg" />
    <element xsi:type="archimate:ApplicationComponent" name="FlightHub (sin flujo)" id="id-ext-fh" />
    <element xsi:type="archimate:ApplicationComponent" name="Portal Aeronáutica (sin flujo)" id="id-ext-portal" />
    <element xsi:type="archimate:ApplicationComponent" name="ICA (sin flujo)" id="id-ext-ica" />
    <element xsi:type="archimate:ApplicationComponent" name="Habilitación (no existe)" id="id-ext-hab" />
    <element xsi:type="archimate:ApplicationService" name="Emitir visto bueno" id="id-as-visto" />
    <element xsi:type="archimate:ApplicationService" name="Registrar horas" id="id-as-horas" />
    <element xsi:type="archimate:ApplicationService" name="Publicar lista" id="id-as-lista" />
    <element xsi:type="archimate:ApplicationProcess" name="Otorgar visto bueno" id="id-ap-visto" />
    <element xsi:type="archimate:DataObject" name="Disponibilidad del dron" id="id-do-disp">
      <documentation>No queda en verde con orden crítica abierta. Esos cuatro subsistemas esperan al jefe. Con las 50 h cumplidas no hay jornada nueva. Hacen falta dos baterías sanas. Condicionado solo el carenado que no toca hélice ni tanque.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Recibir cierre de línea" id="id-cmd-disp-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Dron en verde" id="id-evt-disp-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Otorgar visto bueno" id="id-cmd-disp-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Visto bueno otorgado" id="id-evt-disp-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Marcar sale condicionado" id="id-cmd-disp-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Salida condicionada" id="id-evt-disp-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Publicar en la lista" id="id-cmd-disp-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Incluido en la lista" id="id-evt-disp-3" />
    <element xsi:type="archimate:ApplicationProcess" name="Devolver por pre-vuelo" id="id-cmd-disp-4" />
    <element xsi:type="archimate:ApplicationEvent" name="Devuelto a orden" id="id-evt-disp-4" />
    <element xsi:type="archimate:DataObject" name="Orden de trabajo" id="id-do-ot">
      <documentation>Una entrada, una orden. Un solo número de horas. La firma crítica no pone verde. El de línea no firma motor, baja ni electrónica. Canibalizar solo desde un dron que ya está en orden, con autorización del jefe, y en las dos órdenes. Sin papel ni foto el servicio se vuelve a hacer.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Abrir orden" id="id-cmd-ot-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Orden abierta" id="id-evt-ot-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Agregar hallazgo" id="id-cmd-ot-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Hallazgo en la misma orden" id="id-evt-ot-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Firmar línea" id="id-cmd-ot-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Línea firmada" id="id-evt-ot-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Cerrar trabajo crítico" id="id-cmd-ot-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Quedó pendiente de visto bueno" id="id-evt-ot-3" />
    <element xsi:type="archimate:ApplicationProcess" name="Registrar canibalización" id="id-cmd-ot-4" />
    <element xsi:type="archimate:ApplicationEvent" name="Pieza pasada del donante" id="id-evt-ot-4" />
    <element xsi:type="archimate:DataObject" name="Total de horas" id="id-do-horas">
      <documentation>No se suman piloto y app. Diez horas o más por encima: manda la app. App por debajo porque no cerraron la misión: manda la hoja. FlightHub no entra.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Registrar la pantalla" id="id-cmd-horas-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Horas fijadas por la pantalla" id="id-evt-horas-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Corregir con la app" id="id-cmd-horas-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Hoja corregida" id="id-evt-horas-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Conservar la hoja" id="id-cmd-horas-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Misión abierta, hoja conservada" id="id-evt-horas-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Descartar el mensaje" id="id-cmd-horas-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Mensaje no sumado" id="id-evt-horas-3" />
    <element xsi:type="archimate:DataObject" name="Batería" id="id-do-bat">
      <documentation>No se da de baja sola. La del T50 no entra en el T40. Quieta más de siete días no es baja. Sobre 500 ciclos solo con autorización, sin hinchazón, celdas parejas y lote cerca de carretera.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Apartar" id="id-cmd-bat-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Batería apartada" id="id-evt-bat-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Proponer baja" id="id-cmd-bat-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Baja propuesta" id="id-evt-bat-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Dar de baja" id="id-cmd-bat-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Baja decidida por el jefe" id="id-evt-bat-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Autorizar sobre 500" id="id-cmd-bat-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Excepción de pico de arroz" id="id-evt-bat-3" />
    <element xsi:type="archimate:ApplicationProcess" name="Guardar a media carga" id="id-cmd-bat-4" />
    <element xsi:type="archimate:ApplicationEvent" name="Quedó a media carga" id="id-evt-bat-4" />
    <element xsi:type="archimate:DataObject" name="Observación de las cinco" id="id-do-ind">
      <documentation>Disponible es quien puede entrar mañana, en el aire o sobrando en tierra. No es el mediodía en FlightHub. El preventivo a tiempo no es falla. Si falta el dato, no se escribe cero.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Cerrar el conteo" id="id-cmd-ind-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Lista del día guardada" id="id-evt-ind-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Anotar lote del taller" id="id-cmd-ind-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Lote corrido contado" id="id-evt-ind-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Pedir el costo" id="id-cmd-ind-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Costo publicado o dejado vacío" id="id-evt-ind-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Pedir el tiempo medio" id="id-cmd-ind-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Tiempo medio rechazado" id="id-evt-ind-3" />
    <element xsi:type="archimate:DataObject" name="Retención" id="id-do-ret">
      <documentation>El taller no radica y no entra al portal. Un comentario de otro operador no para la flota. Si no hay papel ni foto, no se inventa el servicio.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Recibir mensaje" id="id-cmd-ret-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Dron frenado por papeles" id="id-evt-ret-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Comparar seriales" id="id-cmd-ret-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Coincidencia de serial" id="id-evt-ret-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Frenar ya" id="id-cmd-ret-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Dron frenado por boletín" id="id-evt-ret-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Diferir a las 50 h" id="id-cmd-ret-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Boletín dejado para la revisión" id="id-evt-ret-3" />
    <element xsi:type="archimate:ApplicationProcess" name="Entregar carpeta" id="id-cmd-ret-4" />
    <element xsi:type="archimate:ApplicationEvent" name="Carpeta entregada a seguridad" id="id-evt-ret-4" />
    <element xsi:type="archimate:DataObject" name="Pedido de repuesto" id="id-do-ped">
      <documentation>Sin código de bodega. Siigo no devuelve existencia. Si la pieza no está, el dron no sale aunque el lote esté prometido. La garantía no suelta el vuelo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Pedir por nombre y modelo" id="id-cmd-ped-0" />
    <element xsi:type="archimate:ApplicationEvent" name="Pieza pedida" id="id-evt-ped-0" />
    <element xsi:type="archimate:ApplicationProcess" name="Registrar llegada" id="id-cmd-ped-1" />
    <element xsi:type="archimate:ApplicationEvent" name="Llegada avisada" id="id-evt-ped-1" />
    <element xsi:type="archimate:ApplicationProcess" name="Adjuntar costo" id="id-cmd-ped-2" />
    <element xsi:type="archimate:ApplicationEvent" name="Costo adjuntado" id="id-evt-ped-2" />
    <element xsi:type="archimate:ApplicationProcess" name="Negar la suelta" id="id-cmd-ped-3" />
    <element xsi:type="archimate:ApplicationEvent" name="Dron sigue en orden" id="id-evt-ped-3" />
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology" />
  <folder name="Motivation" id="id-folder-motivation" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Jefe de mantenimiento" id="id-sh-jefe">
      <documentation>Decide el visto bueno, la baja de la batería, el condicionado y si se obedece un boletín.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Coordinador de operaciones" id="id-sh-coord">
      <documentation>Arma finca, piloto y dron. No abre la orden ni acorta la prueba.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Pilotos" id="id-sh-piloto">
      <documentation>Reportan la novedad. No firman la orden ni devuelven el dron al servicio.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Técnicos de taller y de línea" id="id-sh-tec">
      <documentation>Firman el trabajo de su subsistema. La firma no suelta el vuelo crítico.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Seguridad y gerencia" id="id-sh-seg">
      <documentation>Llevan registro, póliza y el portal. Al taller le llega un mensaje, no el oficio.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Comercial" id="id-sh-com">
      <documentation>Factura hectáreas en Siigo. El cliente no contrata el mantenimiento.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Flota lista para mañana" id="id-dr-flota">
      <documentation>Con caña y arroz, la referencia son 18 de 24. De 16 para abajo se corren lotes.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="No soltar un dron inseguro" id="id-dr-seg" />
    <element xsi:type="archimate:Driver" name="Cumplir el manual de operaciones" id="id-dr-man">
      <documentation>Revisión de 50 h y visita de motor a las 200 h o a los seis meses.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="No volar si falta la pieza" id="id-dr-pieza" />
    <element xsi:type="archimate:Assessment" name="Bajo 16 se corren lotes" id="id-as-16" />
    <element xsi:type="archimate:Assessment" name="Cero verdes con 50 h vencidas" id="id-as-50" />
    <element xsi:type="archimate:Assessment" name="Sin dato, el indicador no existe" id="id-as-dato">
      <documentation>Publicarlo en cero diría que no hubo gasto o que no hubo fallas.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Lista confiable antes de las 17:00" id="id-gl-lista" />
    <element xsi:type="archimate:Goal" name="Visto bueno antes del vuelo crítico" id="id-gl-visto">
      <documentation>Es la decisión que no puede fallar. Si el jefe no contesta, el dron se queda.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Un solo total de horas" id="id-gl-horas" />
    <element xsi:type="archimate:Goal" name="Indicador solo si el dato existe" id="id-gl-ind" />
    <element xsi:type="archimate:Goal" name="50 h y visita de motor al día" id="id-gl-plan" />
    <element xsi:type="archimate:Goal" name="No salir si falta el repuesto" id="id-gl-pieza" />
    <element xsi:type="archimate:Outcome" name="Operaciones programa solo lo publicado" id="id-oc-prog" />
    <element xsi:type="archimate:Outcome" name="Sin respuesta, el dron se queda en tierra" id="id-oc-tierra" />
    <element xsi:type="archimate:Principle" name="La firma no es el visto bueno" id="id-pr-firma" />
    <element xsi:type="archimate:Principle" name="Manda lo que se cumple primero" id="id-pr-primero">
      <documentation>En el motor, 200 h o seis meses. No se escoge el más holgado.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="No hay cruce entre T40 y T50" id="id-pr-cruce" />
    <element xsi:type="archimate:Principle" name="No se publica un indicador en cero" id="id-pr-cero" />
    <element xsi:type="archimate:Principle" name="El taller no programa, no factura y no dosifica" id="id-pr-fuera" />
    <element xsi:type="archimate:Requirement" name="Regla de precedencia de las horas" id="id-rq-horas">
      <documentation>Si se leyó la pantalla, esa manda. Si la app supera la hoja en 10 h o más, se corrige la hoja. Si la app quedó corta porque no cerraron la misión, se queda la hoja. No se suma el mensaje del piloto.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Verde, pendiente, condicionado y en OT" id="id-rq-est">
      <documentation>Hélice, boquilla, filtro y lavado los cierra el de línea. Motor, bomba, batería y electrónica esperan al jefe.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Lista: número, si sale, límite y motivo" id="id-rq-lista">
      <documentation>No se entrega el despiece ni la póliza ni la regla de las 50 h.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="No armar jornada con la revisión pendiente" id="id-rq-plan">
      <documentation>No se corta el lote ya empezado. La de 50 h no borra la visita de motor.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="La baja de la batería la decide el jefe" id="id-rq-baja">
      <documentation>Hacen falta al menos dos sanas del modelo para publicar. El kit de salida son tres.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Frenar por boletín o por papeles" id="id-rq-ret">
      <documentation>Si el texto dice que no vuele, sale ese día. Si dice en la próxima de 50 h, no se saca antes.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Sin portal con la Aeronáutica ni con el ICA" id="id-cn-portal" />
    <element xsi:type="archimate:Constraint" name="No reemplaza Agras, FlightHub, Siigo ni la estantería" id="id-cn-app" />
    <element xsi:type="archimate:Constraint" name="No suma el mensaje del piloto con la app" id="id-cn-suma" />
    <element xsi:type="archimate:Constraint" name="No recibe drones ajenos ni lleva habilitación" id="id-cn-ajeno" />
    <element xsi:type="archimate:Meaning" name="Disponible (taller)" id="id-sig-disp">
      <documentation>Puede entrar al programa de mañana: el que va a volar y el que sobra en verde.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Disponible (FlightHub)" id="id-sig-fh">
      <documentation>Ubicación a mediodía. El taller no la usa para el conteo.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Horas de la hoja" id="id-sig-hoja">
      <documentation>Un solo total. Dispara las 50 y las 200.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Horas del mensaje" id="id-sig-msg">
      <documentation>Lo que el piloto escribe. No se vuelve a sumar si ya se leyó la pantalla.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Firma del técnico" id="id-sig-firma">
      <documentation>Cierra su trabajo en el papel. No autoriza el siguiente vuelo crítico.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Visto bueno" id="id-sig-visto">
      <documentation>Mensaje del jefe. Sin él, motor, bomba, batería y electrónica no salen.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Preventivo" id="id-sig-prev">
      <documentation>Encabezado de la misma orden: 50 h o visita de motor. No abre garantía ni es una falla.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Falla" id="id-sig-falla">
      <documentation>Daño que retiene. El preventivo a tiempo no cuenta. La de 50 h hecha tarde es falta del taller, no falla del dron.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Baja" id="id-sig-baja">
      <documentation>La decide el jefe. Hinchar, alerta o 500 ciclos solo proponen.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Media carga" id="id-sig-media">
      <documentation>Batería quieta más de siete días. No es una baja.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Registro aeronáutico" id="id-sig-reg">
      <documentation>Lo hace seguridad en línea al comprar. El taller no entra al portal.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Carpeta del dron" id="id-sig-carp">
      <documentation>Órdenes en físico. La foto de OneDrive no es la Aeronáutica.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Prometida" id="id-sig-prom">
      <documentation>El coordinador ya comprometió el lote. No suelta el equipo.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Factura" id="id-sig-fac">
      <documentation>Siigo, por las hectáreas que sí se volaron. No se usa para soltar un dron.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation_migration" type="implementation_migration" />
  <folder name="Other" id="id-folder-other" type="other" />
  <folder name="Relations" id="id-folder-relations" type="relations">
    <element xsi:type="archimate:AssociationRelationship" name="persiste" id="id-r1" source="id-do-disp" target="id-ag-disp" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r2" source="id-ag-disp" target="id-ag-disp-0" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r3" source="id-ag-disp" target="id-ag-disp-1" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r4" source="id-ag-disp" target="id-ag-disp-2" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r5" source="id-ag-disp" target="id-ag-disp-3" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r6" source="id-ag-disp" target="id-ag-disp-4" />
    <element xsi:type="archimate:AccessRelationship" id="id-r7" source="id-cmd-disp-0" target="id-do-disp" accessType="3" />
    <element xsi:type="archimate:TriggeringRelationship" id="id-r8" source="id-cmd-disp-0" target="id-evt-disp-0" />
    <element xsi:type="archimate:AccessRelationship" id="id-r9" source="id-cmd-disp-1" target="id-do-disp" accessType="3" />
    <element xsi:type="archimate:TriggeringRelationship" id="id-r10" source="id-cmd-disp-1" target="id-evt-disp-1" />
    <element xsi:type="archimate:AccessRelationship" id="id-r11" source="id-cmd-disp-2" target="id-do-disp" accessType="3" />
    <element xsi:type="archimate:TriggeringRelationship" id="id-r12" source="id-cmd-disp-2" target="id-evt-disp-2" />
    <element xsi:type="archimate:AccessRelationship" id="id-r13" source="id-cmd-disp-3" target="id-do-disp" accessType="3" />
    <element xsi:type="archimate:TriggeringRelationship" id="id-r14" source="id-cmd-disp-3" target="id-evt-disp-3" />
    <element xsi:type="archimate:AccessRelationship" id="id-r15" source="id-cmd-disp-4" target="id-do-disp" accessType="3" />
    <element xsi:type="archimate:TriggeringRelationship" id="id-r16" source="id-cmd-disp-4" target="id-evt-disp-4" />
    <element xsi:type="archimate:AssociationRelationship" name="persiste" id="id-r17" source="id-do-ot" target="id-ag-ot" />
    <element xsi:type="archimate:CompositionRelationship" id="id-r18" source="id-ag-ot" target="id-ag-ot-0" />
