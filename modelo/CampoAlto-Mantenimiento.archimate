    </folder>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <folder name="V5 Contextos" id="id-fld-application-10">
      <element xsi:type="archimate:ApplicationComponent" name="Soltar el vuelo" id="cmp-soltar">
        <documentation>Dominio central. Único que pasa a verde un motor, una bomba, una batería o la electrónica.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Plan y despiece" id="cmp-plan">
        <documentation>Soporte. Despiece por modelo con la condición de cada pieza; vencimientos de 50 h y de motor.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Intervención y orden" id="cmp-ot">
        <documentation>Soporte. Cierra el trabajo. No pone el verde crítico.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Horas de vuelo" id="cmp-horas">
        <documentation>Soporte. Aplica la regla de una sola cifra.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Baterías" id="cmp-bat">
        <documentation>Soporte. Aparta y propone. No da de baja sola.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Retención y expediente" id="cmp-ret">
        <documentation>Soporte. Obedece el mensaje. No entra al portal.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Pedido de repuesto" id="cmp-ped">
        <documentation>Soporte. Pide por nombre y modelo. No inventa existencia.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Indicadores del día" id="cmp-ind">
        <documentation>Soporte. Cuenta quién puede entrar mañana. No publica cero.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Identidad T40/T50" id="cmp-id">
        <documentation>Genérico. Número, modelo y serial. Núcleo compartido.</documentation>
      </element>
    </folder>
    <folder name="V9 Sistemas externos" id="id-fld-application-11">
      <element xsi:type="archimate:ApplicationComponent" name="App del Agras (control remoto)" id="ext-agras">
        <documentation>Del fabricante. Horas, caudal, alerta de batería y ciclos.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Grupo «Novedades campo»" id="ext-novedades">
        <documentation>WhatsApp de pilotos y técnicos.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Fotos de Buga y Espinal" id="ext-bases">
        <documentation>Los técnicos de línea mandan la pantalla de las baterías que fallaron.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Grupo «Programa» (coordinador)" id="ext-programa">
        <documentation>WhatsApp del jefe, el coordinador y los técnicos de base.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Operaciones (reclamo de dosis)" id="ext-oper"/>
      <element xsi:type="archimate:ApplicationComponent" name="Siigo (administración)" id="ext-siigo">
        <documentation>Compras y facturas. No devuelve existencia.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Distribuidor de Bogotá" id="ext-dist">
        <documentation>WhatsApp o correo, a veces con un PDF.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Seguridad y gerencia" id="ext-seg">
        <documentation>Mensaje de seguridad o del gerente.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="FlightHub" id="ext-fh">
        <documentation>Ubicación del equipo para operaciones.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Portal de la Aeronáutica" id="ext-portal">
        <documentation>Lo usa seguridad. Sin API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Registro ICA de la etiqueta" id="ext-ica">
        <documentation>Lo revisa el agrónomo.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Registro de habilitación" id="ext-hab">
        <documentation>No existe.</documentation>
      </element>
    </folder>
    <folder name="V10 Servicios de aplicación" id="id-fld-application-12">
      <element xsi:type="archimate:ApplicationService" name="Decidir la salida del dron" id="app-soltar"/>
      <element xsi:type="archimate:ApplicationService" name="Calcular vencimientos" id="app-plan"/>
      <element xsi:type="archimate:ApplicationService" name="Llevar la orden" id="app-ot"/>
      <element xsi:type="archimate:ApplicationService" name="Registrar horas" id="app-horas"/>
      <element xsi:type="archimate:ApplicationService" name="Cuidar baterías" id="app-bat"/>
      <element xsi:type="archimate:ApplicationService" name="Aplicar frenos" id="app-ret"/>
      <element xsi:type="archimate:ApplicationService" name="Pedir repuestos" id="app-ped"/>
      <element xsi:type="archimate:ApplicationService" name="Contar el día" id="app-ind"/>
      <element xsi:type="archimate:ApplicationService" name="Entregar número y modelo" id="app-id"/>
    </folder>
    <folder name="V9 Interfaces anticorrupción" id="id-fld-application-13">
      <element xsi:type="archimate:ApplicationInterface" name="Lectura del Agras" id="ai-agras-h"/>
      <element xsi:type="archimate:ApplicationInterface" name="Alerta y ciclos del Agras" id="ai-agras-b"/>
      <element xsi:type="archimate:ApplicationInterface" name="Horas del mensaje" id="ai-novedad-h"/>
      <element xsi:type="archimate:ApplicationInterface" name="Novedad de campo" id="ai-novedad-o"/>
      <element xsi:type="archimate:ApplicationInterface" name="Recuento del lunes" id="ai-recuento"/>
      <element xsi:type="archimate:ApplicationInterface" name="Lista de las cinco" id="ai-lista"/>
      <element xsi:type="archimate:ApplicationInterface" name="Lote corrido" id="ai-lote"/>
      <element xsi:type="archimate:ApplicationInterface" name="Costo de Siigo" id="ai-costo"/>
      <element xsi:type="archimate:ApplicationInterface" name="Pedido al distribuidor" id="ai-pedir"/>
      <element xsi:type="archimate:ApplicationInterface" name="Aviso de llegada" id="ai-llegada"/>
      <element xsi:type="archimate:ApplicationInterface" name="Boletín del fabricante" id="ai-boletin"/>
      <element xsi:type="archimate:ApplicationInterface" name="Freno de seguridad" id="ai-freno"/>
      <element xsi:type="archimate:ApplicationInterface" name="Carpeta para seguridad" id="ai-carpeta"/>
      <element xsi:type="archimate:ApplicationInterface" name="Última probeta" id="ai-probeta"/>
      <element xsi:type="archimate:ApplicationService" name="Traducir horas del Agras" id="asv-agras-h"/>
      <element xsi:type="archimate:ApplicationService" name="Traducir alerta y ciclos" id="asv-agras-b"/>
      <element xsi:type="archimate:ApplicationService" name="Descartar horas del mensaje" id="asv-novedad-h"/>
      <element xsi:type="archimate:ApplicationService" name="Convertir la novedad en síntoma" id="asv-novedad-o"/>
      <element xsi:type="archimate:ApplicationService" name="Cargar el recuento" id="asv-recuento"/>
      <element xsi:type="archimate:ApplicationService" name="Publicar la lista" id="asv-lista"/>
      <element xsi:type="archimate:ApplicationService" name="Contar el lote corrido" id="asv-lote"/>
      <element xsi:type="archimate:ApplicationService" name="Adjuntar el costo" id="asv-costo"/>
      <element xsi:type="archimate:ApplicationService" name="Pedir por nombre y modelo" id="asv-pedir"/>
      <element xsi:type="archimate:ApplicationService" name="Registrar la llegada" id="asv-llegada"/>
      <element xsi:type="archimate:ApplicationService" name="Comparar seriales del boletín" id="asv-boletin"/>
      <element xsi:type="archimate:ApplicationService" name="Acatar el freno" id="asv-freno"/>
      <element xsi:type="archimate:ApplicationService" name="Armar la carpeta" id="asv-carpeta"/>
      <element xsi:type="archimate:ApplicationService" name="Entregar la probeta" id="asv-probeta"/>
    </folder>
    <folder name="V6 Soltar el vuelo" id="id-fld-application-14">
      <element xsi:type="archimate:DataObject" name="Disponibilidad del dron" id="do-disp" profiles="pf-root">
        <documentation>No pasa a verde con una orden abierta de motor, bomba, batería o electrónica. Lo crítico solo pasa a verde con el visto bueno del jefe. Con las 50 h cumplidas no hay jornada nueva hasta la revisión. Con la visita de motor vencida no hay verde hasta la visita y el visto bueno. Con menos de dos baterías sanas del modelo no entra a la lista. Condicionado solo el carenado que no toca hélice ni tanque, y lo escribe el jefe. Frenado no sale, lleve las horas que lleve.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Estado: en OT, pendiente, verde, condicionado o frenado" id="do-disp-estado" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Visto bueno: quién y cuándo" id="do-disp-visto" profiles="pf-ent"/>
      <element xsi:type="archimate:DataObject" name="Límite del condicionado" id="do-disp-limite" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Baterías sanas del modelo" id="do-disp-bat" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Número y modelo" id="do-disp-ref" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Recibir cierre de línea" id="cmd-rec-linea" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron en verde" id="evt-verde" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Recibir cierre crítico" id="cmd-rec-critico" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Quedó pendiente de visto bueno" id="evt-pendiente" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Dar el visto bueno" id="cmd-visto" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Visto bueno otorgado" id="evt-visto" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Marcar sale condicionado" id="cmd-cond" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Salida condicionada" id="evt-cond" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Frenar por retención" id="cmd-frenar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron frenado" id="evt-frenado" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Devolver por pre-vuelo" id="cmd-devolver" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Devuelto a orden" id="evt-devuelto" profiles="pf-evt"/>
      <element xsi:type="archimate:DataObject" name="Lista de las cinco" id="do-lista" profiles="pf-root">
        <documentation>Se publica antes de las 17:00. Cada renglón lleva número, si sale, el límite o el motivo. Lo que queda en verde después del corte no entra solo a la madrugada. No lleva despiece, regla de 50 h ni póliza.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Renglón: número, si sale, límite o motivo" id="do-lista-renglon" profiles="pf-ent"/>
      <element xsi:type="archimate:DataObject" name="Corte de las 17:00" id="do-lista-corte" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Cortar la lista de las cinco" id="cmd-corte" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Lista publicada" id="evt-lista" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar verde después del corte" id="cmd-tarde" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Verde fuera de la lista" id="evt-tarde" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Intervención y orden" id="id-fld-application-15">
      <element xsi:type="archimate:DataObject" name="Orden de trabajo" id="do-ot" profiles="pf-root">
        <documentation>Una entrada, una orden: el hallazgo se agrega, no se abre otro papel. Un solo número de horas: el de la hoja ya corregida. Firma quien hizo el trabajo, y solo en su subsistema. El de línea no abre motor, no da de baja una batería y no toca electrónica; en campaña cambia la bomba completa en el portalón. La firma del cierre crítico no pone verde. Si hubo golpe, minuto estacionario sin producto antes del verde de línea. Canibalizar solo desde un dron que ya está en orden, con autorización del jefe y en las dos órdenes. Sin papel ni foto, el servicio se vuelve a hacer.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Línea de intervención: subsistema, pieza, serial y firma" id="do-ot-linea" profiles="pf-ent"/>
      <element xsi:type="archimate:DataObject" name="Motivo de entrada: 50 h, motor, síntoma, boletín o pre-vuelo" id="do-ot-motivo" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Horas anotadas: un solo número" id="do-ot-horas" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Evidencia: papel y foto" id="do-ot-evidencia" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Canibalización: donante y autorización" id="do-ot-donante" profiles="pf-ent"/>
      <element xsi:type="archimate:ApplicationProcess" name="Abrir orden" id="cmd-abrir" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Orden abierta" id="evt-abierta" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Agregar hallazgo" id="cmd-hallazgo" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Hallazgo en la misma orden" id="evt-hallazgo" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Firmar línea" id="cmd-firmar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Línea firmada" id="evt-firmada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Cerrar trabajo de línea" id="cmd-cerrar-linea" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Cierre de línea registrado" id="evt-cierre-linea" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Cerrar trabajo crítico" id="cmd-cerrar-critico" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Cierre crítico registrado" id="evt-cierre-critico" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar pieza que falta" id="cmd-faltante" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Pieza faltante anotada" id="evt-faltante" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Registrar canibalización" id="cmd-canibal" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Pieza pasada del donante" id="evt-canibal" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Horas de vuelo" id="id-fld-application-16">
      <element xsi:type="archimate:DataObject" name="Total de horas" id="do-horas" profiles="pf-root">
        <documentation>No se suman el mensaje del piloto y la app. Si se leyó la pantalla, esa manda. Si la app trae 10 h o más por encima de la hoja, se corrige la hoja. Si la app trae menos porque no cerraron la misión, se queda la hoja y el piloto la cierra. FlightHub no entra en la cuenta.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Lectura de pantalla" id="do-horas-pantalla" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Lectura de la app" id="do-horas-app" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Mensaje del piloto" id="do-horas-msg" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Horas desde la última 50" id="do-horas-desde" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Registrar la pantalla" id="cmd-pantalla" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Horas fijadas por la pantalla" id="evt-pantalla" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Corregir con la app" id="cmd-app" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Hoja corregida con la app" id="evt-app" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Conservar la hoja" id="cmd-conservar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Misión abierta, hoja conservada" id="evt-conservar" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Descartar el mensaje del piloto" id="cmd-descartar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Mensaje no sumado" id="evt-descartar" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Baterías" id="id-fld-application-17">
      <element xsi:type="archimate:DataObject" name="Batería" id="do-bat" profiles="pf-root">
        <documentation>No se da de baja sola: la firma el jefe. La del T50 no entra en el T40. Quieta más de siete días se guarda a media carga, y eso no es baja. Sobre 500 ciclos solo con autorización, sin hinchazón, celdas parejas y lote cerca de carretera. Caliente espera a tibiar; hinchada no se conecta. El de línea puede apartarla y mandar foto; no la carga.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Modelo: T40 o T50" id="do-bat-modelo" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Ciclos" id="do-bat-ciclos" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Alerta o hinchazón" id="do-bat-alerta" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Estado: sana, apartada, media carga, baja propuesta o de baja" id="do-bat-estado" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Apartar" id="cmd-apartar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Batería apartada" id="evt-apartada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Proponer baja" id="cmd-proponer" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Baja propuesta" id="evt-propuesta" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Dar de baja" id="cmd-baja" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Baja firmada por el jefe" id="evt-baja" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Autorizar sobre 500 ciclos" id="cmd-500" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Excepción de pico de arroz" id="evt-500" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Guardar a media carga" id="cmd-media" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Quedó a media carga" id="evt-media" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Contar las sanas del modelo" id="cmd-contar-bat" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Sanas del modelo contadas" id="evt-sanas" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Indicadores del día" id="id-fld-application-18">
      <element xsi:type="archimate:DataObject" name="Observación de las cinco" id="do-ind" profiles="pf-root">
        <documentation>Disponible es quien puede entrar mañana, vuele o sobre en tierra. No es el conteo de FlightHub a mediodía. Un preventivo a tiempo no es una falla. Si falta el dato, el indicador queda vacío: no se publica cero. Un lote corrido porque el cliente no tuvo el químico no cuenta.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Disponibles a las cinco" id="do-ind-disp" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Lotes corridos por el taller" id="do-ind-lotes" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Fallos críticos de pre-vuelo" id="do-ind-fallos" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Verdes con 50 h vencidas" id="do-ind-vencidos" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Espera de Bogotá" id="do-ind-bogota" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Costo del repuesto, si existe" id="do-ind-costo" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Cerrar el conteo de las cinco" id="cmd-ind-conteo" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Observación guardada" id="evt-ind-guardada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar lote corrido por el taller" id="cmd-ind-lote" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Lote corrido contado" id="evt-ind-lote" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar fallo de pre-vuelo" id="cmd-ind-fallo" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Fallo de pre-vuelo contado" id="evt-ind-fallo" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar espera de Bogotá" id="cmd-ind-bogota" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Espera de Bogotá contada" id="evt-ind-bogota" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Pedir el costo" id="cmd-ind-costo" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Costo publicado o dejado vacío" id="evt-ind-costo" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Pedir el tiempo medio entre fallas" id="cmd-ind-mtbf" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Tiempo medio no calculado" id="evt-ind-mtbf" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Retención y expediente" id="id-fld-application-19">
      <element xsi:type="archimate:DataObject" name="Retención" id="do-ret" profiles="pf-root">
        <documentation>Se obedece el mensaje de seguridad: no se reinterpreta. El taller no entra al portal ni radica. Un comentario de otro operador no para la flota. Por registro o póliza se termina la jornada empezada y no se programa otra. Por boletín de seguridad, motor o batería no se carga otro tanque. Si seguridad dice que no se desarme, no se desarma, salvo la batería con riesgo de incendio.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Mensaje de seguridad: registro, póliza o incidente" id="do-ret-msg" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Boletín: rango de seriales, pieza y alcance" id="do-ret-boletin" profiles="pf-ent"/>
      <element xsi:type="archimate:DataObject" name="Carpeta del dron: órdenes, registro y póliza" id="do-ret-carpeta" profiles="pf-ent"/>
      <element xsi:type="archimate:ApplicationProcess" name="Recibir mensaje de seguridad" id="cmd-ret-msg" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron frenado por papeles" id="evt-ret-papeles" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Comparar seriales del boletín" id="cmd-ret-comparar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Coincidencia de serial" id="evt-ret-coincide" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Frenar ya por boletín" id="cmd-ret-frenar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron frenado por boletín" id="evt-ret-boletin" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Diferir a la revisión de 50 h" id="cmd-ret-diferir" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Boletín dejado para la revisión" id="evt-ret-diferido" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Entregar la carpeta" id="cmd-ret-carpeta" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Carpeta entregada a seguridad" id="evt-ret-carpeta" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Pedido de repuesto" id="id-fld-application-20">
      <element xsi:type="archimate:DataObject" name="Pedido de repuesto" id="do-ped" profiles="pf-root">
        <documentation>Sin código de bodega. Siigo no devuelve existencia ni fecha. Si la pieza no llegó, el dron no sale aunque el lote esté prometido. No se monta pieza de otro modelo. La garantía no suelta el vuelo: si hay pieza en la estantería, se monta la nuestra.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Pieza por nombre y modelo" id="do-ped-pieza" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Número de parte, si Bogotá lo pide" id="do-ped-parte" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Aviso de llegada" id="do-ped-llegada" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Costo, si lo pasan" id="do-ped-costo" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Pedir por nombre y modelo" id="cmd-pedir" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Pieza pedida" id="evt-pedida" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Registrar llegada" id="cmd-llegada" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Llegada avisada" id="evt-llegada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Adjuntar costo" id="cmd-costo" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Costo adjuntado" id="evt-costo" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Mantener el dron en orden" id="cmd-espera" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron sigue esperando la pieza" id="evt-espera" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Plan y despiece" id="id-fld-application-21">
      <element xsi:type="archimate:DataObject" name="Despiece del dron" id="do-despiece" profiles="pf-root">
        <documentation>Nada de T40 se monta en un T50, ni al revés. Hélice y atomizador se cambian de a par. El T50 lleva dos bombas y no sale con una. Hélice por estado; boquilla por estado y caudal; bomba por probeta (T40 bajo 10 L/min, T50 bajo 13) o síntoma. Motor por síntoma y visita; batería por alerta, hinchazón, rendimiento o 500 ciclos.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Pieza montada: subsistema, posición y serial" id="do-desp-pieza" profiles="pf-ent"/>
      <element xsi:type="archimate:DataObject" name="Condición de la pieza: horas, ciclos, calendario o estado" id="do-desp-cond" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Modelo: T40 o T50" id="do-desp-modelo" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Repuesto requerido: nombre, modelo y si va de a par" id="do-desp-repuesto" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Montar pieza" id="cmd-montar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Pieza montada" id="evt-montada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Retirar pieza" id="cmd-retirar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Pieza retirada con su serial" id="evt-retirada" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Rechazar pieza de otro modelo" id="cmd-rechazar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Cruce de modelo rechazado" id="evt-rechazo" profiles="pf-evt"/>
      <element xsi:type="archimate:DataObject" name="Plan del dron" id="do-plan" profiles="pf-root">
        <documentation>La de 50 h entra al cerrar la jornada en que se cumple. No se corta un lote ya empezado. No se arma jornada nueva con la revisión pendiente. Motor: 200 h o seis meses, lo que llegue primero. La de 50 h no borra la de motor, ni al revés. La bomba no vence por calendario.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Vencimiento de 50 h" id="do-plan-50" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Vencimiento de motor: 200 h o seis meses" id="do-plan-motor" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Boletín para la próxima 50" id="do-plan-boletin" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Recalcular con las horas" id="cmd-recalcular" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Revisión de 50 h vencida" id="evt-vencida-50" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Revisar la fecha de motor" id="cmd-fecha" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Visita de motor vencida" id="evt-vencida-motor" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Anotar boletín para la 50" id="cmd-boletin50" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Boletín en la próxima revisión" id="evt-boletin50" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Cerrar la revisión" id="cmd-revision" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Revisión hecha" id="evt-revision" profiles="pf-evt"/>
    </folder>
    <folder name="V6 Identidad T40/T50" id="id-fld-application-22">
      <element xsi:type="archimate:DataObject" name="Dron" id="do-dron" profiles="pf-root">
        <documentation>Número, modelo y serial son los mismos en todos los contextos. Solo existen los 24 drones de la flota. Seis T50 entregados desde noviembre de 2025 siguen en garantía; el resto no.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Número" id="do-dron-num" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Modelo: T40 o T50" id="do-dron-modelo" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Serial" id="do-dron-serial" profiles="pf-vo"/>
      <element xsi:type="archimate:DataObject" name="Fecha de entrega (garantía de un año)" id="do-dron-entrega" profiles="pf-vo"/>
      <element xsi:type="archimate:ApplicationProcess" name="Registrar dron de la flota" id="cmd-registrar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron registrado" id="evt-registrado" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Consultar número y modelo" id="cmd-consultar" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Número y modelo entregados" id="evt-consultado" profiles="pf-evt"/>
      <element xsi:type="archimate:ApplicationProcess" name="Rechazar dron de afuera" id="cmd-ajeno" profiles="pf-cmd"/>
      <element xsi:type="archimate:ApplicationEvent" name="Dron ajeno rechazado" id="evt-ajeno" profiles="pf-evt"/>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation">
    <folder name="V1 Motivación" id="id-fld-motivation-1">
      <element xsi:type="archimate:Stakeholder" name="Jefe de mantenimiento" id="sh-jefe">
        <documentation>Decide el visto bueno de motor, bomba, batería y electrónica, la baja de la batería, el condicionado y si un boletín frena el dron.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Coordinador de operaciones" id="sh-coord">
        <documentation>Arma finca, piloto y dron con la lista. No abre la orden ni acorta la prueba.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Cliente (ingenio o arrocero)" id="sh-cli">
        <documentation>Paga la hectárea aplicada. Si el lote se corre, le avisa el coordinador.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Pilotos" id="sh-piloto">
        <documentation>Reportan la novedad y hacen el pre-vuelo. No firman la orden ni devuelven el dron al servicio.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Técnicos de taller y de línea" id="sh-tec">
        <documentation>Firman el trabajo de su subsistema. La firma no suelta el vuelo crítico.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Seguridad y gerencia" id="sh-seg">
        <documentation>Llevan registro, póliza, certificado RPAS y el manual de operaciones. Al taller le mandan un mensaje, no el oficio.</documentation>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Comercial y administración" id="sh-com">
        <documentation>Facturan hectáreas y compras en Siigo. El costo del repuesto solo sale si alguien abre la factura.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Flota lista para el programa de mañana" id="dr-flota">
        <documentation>Con caña y arroz abiertos, la referencia son 18 de 24.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="No soltar un dron inseguro" id="dr-seg">
        <documentation>Motor, bomba, batería y electrónica no salen porque el técnico firmó, el lote está prometido o el piloto quiere terminar.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Datos copiados a mano en varios lados" id="dr-dato">
        <documentation>Hoja «Control de flota», orden en papel, foto en OneDrive y dos grupos de WhatsApp.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Manual de operaciones y Aeronáutica" id="dr-man">
        <documentation>Piden ver fecha, dron, horas, qué se cambió y quién firmó.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Repuesto que tarda en llegar" id="dr-pieza">
        <documentation>Lo que no se recupera en Palmira se pide a Bogotá: una a tres semanas.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="De 16 disponibles para abajo se corren lotes" id="as-16">
        <documentation>En caña, más de dos lotes corridos por el taller en la semana ya es mala semana.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Un motor, bomba o batería que falla en el pre-vuelo no se vio en la tarde" id="as-prev"/>
      <element xsi:type="archimate:Assessment" name="El visto bueno queda en un mensaje que se pierde en el grupo" id="as-mensaje">
        <documentation>El papel puede estar firmado y el mensaje ya se fue hacia arriba: el coordinador arma con un dron que no se soltó.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Las horas se pisan o se suman dos veces" id="as-horas">
        <documentation>Queda el último número, no el vuelo. Si se suman el mensaje y la app, el dron entra a revisión de más.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="A veces la fecha de motor se pasa unos días" id="as-50">
        <documentation>No hay alerta: se ve en la hoja, en las horas y en la fecha de la última orden de motor.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Con tres o más esperando a Bogotá, la estantería no alcanza" id="as-bogota"/>
      <element xsi:type="archimate:Assessment" name="Sin costo ni conteo de fallas no hay indicador" id="as-cero">
        <documentation>El costo está en Siigo y las fallas en papeles. Mientras no se cuenten, no hay número.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Un servicio sin papel ni foto no existe" id="as-papel">
        <documentation>No se inventa: se vuelve a hacer y se anota que el anterior no aparece.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Lista confiable antes de las 17:00" id="gl-lista"/>
      <element xsi:type="archimate:Goal" name="Ningún vuelo crítico sin visto bueno del jefe" id="gl-visto"/>
      <element xsi:type="archimate:Goal" name="Un solo total de horas por dron" id="gl-horas"/>
      <element xsi:type="archimate:Goal" name="Revisión de 50 h y visita de motor al día" id="gl-plan"/>
      <element xsi:type="archimate:Goal" name="Ningún dron sale si falta el repuesto" id="gl-pieza"/>
      <element xsi:type="archimate:Goal" name="Indicadores solo con dato real" id="gl-ind"/>
      <element xsi:type="archimate:Goal" name="Expediente del dron completo para seguridad" id="gl-exp"/>
      <element xsi:type="archimate:Outcome" name="Operaciones programa solo lo publicado" id="oc-prog"/>
      <element xsi:type="archimate:Outcome" name="No más de dos lotes corridos por el taller en la semana de caña" id="oc-lotes"/>
      <element xsi:type="archimate:Outcome" name="Sin respuesta del jefe, el dron se queda en tierra" id="oc-tierra"/>
      <element xsi:type="archimate:Outcome" name="Cero fallos de motor, bomba o batería en el pre-vuelo" id="oc-prevuelo"/>
      <element xsi:type="archimate:Outcome" name="Cero verdes con las 50 h vencidas" id="oc-50"/>
      <element xsi:type="archimate:Principle" name="La firma no es el visto bueno" id="pr-firma"/>
      <element xsi:type="archimate:Principle" name="El dato nace en su sistema: no se inventa" id="pr-origen"/>
      <element xsi:type="archimate:Principle" name="Horas y calendario mandan los dos: gana lo que se cumpla primero" id="pr-primero"/>
      <element xsi:type="archimate:Principle" name="El repuesto no se cruza entre T40 y T50" id="pr-cruce"/>
      <element xsi:type="archimate:Principle" name="No se publica un indicador en cero" id="pr-cero"/>
      <element xsi:type="archimate:Requirement" name="Lista con número, si sale, límite y motivo, antes de las 17:00" id="rq-lista"/>
      <element xsi:type="archimate:Requirement" name="Frenar por boletín o por mensaje de seguridad" id="rq-freno"/>
      <element xsi:type="archimate:Requirement" name="Estados: en OT, pendiente de visto bueno, verde, sale condicionado, frenado" id="rq-estados"/>
      <element xsi:type="archimate:Requirement" name="Baja de batería solo con firma del jefe; dos sanas para publicar" id="rq-baja"/>
      <element xsi:type="archimate:Requirement" name="Pantalla primero; la app corrige si trae 10 h o más; FlightHub no cuenta" id="rq-precedencia"/>
      <element xsi:type="archimate:Requirement" name="La de 50 h entra al cerrar la jornada; no se arma jornada nueva" id="rq-50"/>
      <element xsi:type="archimate:Requirement" name="Visita de motor a las 200 h o a los seis meses" id="rq-motor"/>
      <element xsi:type="archimate:Requirement" name="Despiece por modelo con la condición de cada pieza" id="rq-despiece"/>
      <element xsi:type="archimate:Requirement" name="Pedido por nombre y modelo; sin pieza el dron sigue en orden" id="rq-pedido"/>
      <element xsi:type="archimate:Requirement" name="Indicadores del día: disponibles, lotes corridos, fallos de pre-vuelo, verdes vencidos, espera de Bogotá" id="rq-ind"/>
      <element xsi:type="archimate:Requirement" name="Una orden por entrada, con horas, pieza, serial y firma" id="rq-orden"/>
      <element xsi:type="archimate:Constraint" name="El taller no programa fincas, no factura ni define la dosis" id="cn-fuera"/>
      <element xsi:type="archimate:Constraint" name="La telemetría no llega sola: alguien lee la pantalla" id="cn-telemetria"/>
      <element xsi:type="archimate:Constraint" name="El mensaje del piloto no se suma con la app" id="cn-suma"/>
      <element xsi:type="archimate:Constraint" name="No se reciben drones de afuera" id="cn-ajeno"/>
      <element xsi:type="archimate:Constraint" name="Siigo no devuelve existencia ni fecha de llegada" id="cn-siigo"/>
      <element xsi:type="archimate:Constraint" name="Sin portal ni API con la Aeronáutica" id="cn-portal"/>
      <element xsi:type="archimate:Constraint" name="No hay registro de habilitación: el alcance es el puesto" id="cn-hab"/>
    </folder>
    <folder name="V7 Lenguaje ubicuo" id="id-fld-motivation-24">
      <element xsi:type="archimate:Meaning" name="Puede entrar al programa de mañana, vuele o sobre en tierra" id="mn-disp-taller">
        <property key="Dominio" value="Indicadores del día"/>
        <property key="Ejemplo" value="18 de 24 a las cinco"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Dónde está el equipo según FlightHub" id="mn-disp-fh">
        <property key="Contexto" value="Operaciones"/>
        <property key="Ejemplo" value="En el aire a mediodía"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Un solo total por dron, ya reconciliado" id="mn-horas-hoja">
        <property key="Dominio" value="Horas de vuelo"/>
        <property key="Ejemplo" value="Pantalla leída: 47,5 h"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo que el piloto escribe en «Novedades campo»" id="mn-horas-msg">
        <property key="Contexto" value="Campo"/>
        <property key="Ejemplo" value="«Hoy 3 h»: no se suma"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Estado que deja programar al dron" id="mn-verde">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="T50-11 en verde a las 16:40"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Solo cuenta si salió en la lista de las cinco" id="mn-verde-prog">
        <property key="Contexto" value="Programación"/>
        <property key="Ejemplo" value="Verde a las 18:00 no entra solo a la madrugada"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Hallazgo que retiene al dron dentro de la misma orden" id="mn-falla">
        <property key="Dominio" value="Indicadores del día"/>
        <property key="Ejemplo" value="Conector quemado en la revisión de 50 h"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Toda orden, también el preventivo, para un tiempo medio entre fallas" id="mn-falla-mtbf">
        <property key="Contexto" value="Indicador genérico (no se usa)"/>
        <property key="Ejemplo" value="Revisión de 50 h a tiempo contada como falla"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Carpeta física del dron: órdenes con copia del registro y la póliza" id="mn-carpeta">
        <property key="Dominio" value="Retención y expediente"/>
        <property key="Ejemplo" value="La carpeta que seguridad pide una vez al año"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Registro del Agras ante la Aeronáutica, en línea" id="mn-registro-aero">
        <property key="Contexto" value="Seguridad"/>
        <property key="Ejemplo" value="Serial y modelo de un dron nuevo"/>
      </element>
      <element xsi:type="archimate:Meaning" name="El coordinador ya le dijo al cliente que se entra al lote; no suelta el dron" id="mn-prometida">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="Bomba sin llegar y lote prometido: no sale"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Hectáreas facturadas en Siigo después del vuelo" id="mn-factura">
        <property key="Contexto" value="Comercial"/>
        <property key="Ejemplo" value="Factura por lote y fecha"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tiene orden abierta y no sale al día siguiente" id="mn-ot">
        <property key="Dominio" value="Intervención y orden"/>
        <property key="Ejemplo" value="T40-03 en OT por bomba"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Orden crítica cerrada por el técnico, sin el mensaje del jefe" id="mn-pendiente">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="Motor cambiado y firmado, sin mensaje en «Programa»"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Mensaje del jefe en «Programa» que suelta lo crítico" id="mn-visto">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="«T50-07 a verde»"/>
      </element>
      <element xsi:type="archimate:Meaning" name="El técnico terminó su línea; no suelta lo crítico" id="mn-firma">
        <property key="Dominio" value="Intervención y orden"/>
        <property key="Ejemplo" value="Bomba cambiada, serial anotado"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Sale con un límite que escribe el jefe" id="mn-cond">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="Carenado roto que no toca hélice ni tanque"/>
      </element>
      <element xsi:type="archimate:Meaning" name="No sale por boletín o por papeles" id="mn-frenado">
        <property key="Dominio" value="Retención y expediente"/>
        <property key="Ejemplo" value="Póliza vencida: se termina la jornada y no se programa otra"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Mensaje antes de las 17:00 con número, si sale, límite o motivo" id="mn-lista">
        <property key="Dominio" value="Soltar el vuelo"/>
        <property key="Ejemplo" value="«T40-05 no sale: bomba»"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Orden encabezada «50 horas» o «visita de motor», dentro de los límites" id="mn-preventivo">
        <property key="Dominio" value="Plan y despiece"/>
        <property key="Ejemplo" value="Revisión de 50 h sin hallazgos"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Prueba de un minuto con agua para medir el caudal" id="mn-probeta">
        <property key="Dominio" value="Plan y despiece"/>
        <property key="Ejemplo" value="T50 bajo 13 L/min: se abre la bomba"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Hélice y atomizador se cambian en pareja" id="mn-par">
        <property key="Dominio" value="Plan y despiece"/>
        <property key="Ejemplo" value="Pala mordida: cambia el par del brazo"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Pasar una pieza de un dron que ya está en orden a otro" id="mn-canibal">
        <property key="Dominio" value="Intervención y orden"/>
        <property key="Ejemplo" value="Bomba del donante anotada en las dos órdenes"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Decisión del jefe: la batería no vuelve a volar" id="mn-baja">
        <property key="Dominio" value="Baterías"/>
        <property key="Ejemplo" value="500 ciclos con celdas disparejas"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Batería guardada así por estar quieta más de siete días; no es baja" id="mn-media">
        <property key="Dominio" value="Baterías"/>
        <property key="Ejemplo" value="Baterías de Espinal al cerrar la campaña"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lote que se mueve porque el taller no soltó el dron" id="mn-lote">
        <property key="Dominio" value="Indicadores del día"/>
        <property key="Ejemplo" value="No cuenta si el cliente no tuvo el químico"/>
      </element>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation_migration" type="implementation_migration">
  </folder>
  <folder name="Other" id="id-folder-other" type="other">
    <folder name="V3 Proceso E2E" id="id-fld-other-5">
      <element xsi:type="archimate:Junction" name="" id="j-dec" type="or"/>
      <element xsi:type="archimate:Junction" name="" id="j-cie" type="or"/>
    </folder>
    <folder name="V4 Capas de servicio" id="id-fld-other-25">
      <element xsi:type="archimate:Grouping" name="1 · Proceso de punta a punta (End-to-end Business Process) · equipo del taller" id="g-l1"/>
      <element xsi:type="archimate:Grouping" name="2 · Servicio de negocio de plataforma (Platform Business Service) · jefe de mantenimiento" id="g-l2"/>
      <element xsi:type="archimate:Grouping" name="3 · Servicio de dominio (Functional Domain Service) · un servicio por subdominio" id="g-l3"/>
      <element xsi:type="archimate:Grouping" name="4 · Servicio básico del subdominio «Soltar el vuelo» (Functional Subdomain Basic Service)" id="g-l4"/>
      <element xsi:type="archimate:Grouping" name="5 · Servicio de capa anticorrupción (Anti-corruption Layer Service) · aislamiento de externos" id="g-l5"/>
      <element xsi:type="archimate:Grouping" name="6 · Servicio fundamental del subdominio (Fundamental Subdomain Service) · datos maestros" id="g-l6"/>
      <element xsi:type="archimate:Grouping" name="7 · Servicio de infraestructura (Infrastructure Service Layer) · servicios de apoyo" id="g-l7"/>
      <element xsi:type="archimate:Grouping" name="Fuera del alcance: servicios que no se implementan (justificación en la documentación de cada uno)" id="g-l8"/>
    </folder>
    <folder name="V5 Clasificación" id="id-fld-other-26">
      <element xsi:type="archimate:Grouping" name="Dominio central" id="g-central">
        <documentation>La decisión que no puede fallar: soltar el vuelo.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominios de soporte" id="g-soporte">
        <documentation>Alimentan la decisión con un dato y no la reemplazan.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominios genéricos" id="g-generico">
        <documentation>Comunes a cualquier operación o comprados.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Soltar el vuelo" id="g-d-soltar">
        <documentation>Central: es la decisión que no puede fallar aunque fallen la foto, el costo o el papel.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Plan y despiece" id="g-d-plan">
        <documentation>Soporte: dice qué pieza toca y cuándo vence la revisión. No suelta el vuelo.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Intervención y orden" id="g-d-ot">
        <documentation>Soporte: cierra el trabajo con la firma de quien lo hizo. No pone el verde crítico.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Horas de vuelo" id="g-d-horas">
        <documentation>Soporte: entrega un solo total. No decide si el dron sale.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Baterías" id="g-d-bat">
        <documentation>Soporte: dice si hay dos sanas del modelo. La baja la firma el jefe.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Retención y expediente" id="g-d-ret">
        <documentation>Soporte: obedece el freno de seguridad o el boletín. No radica.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Pedido de repuesto" id="g-d-ped">
        <documentation>Soporte: pide por nombre y modelo. Si la pieza no llegó, el dron sigue en orden.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Indicadores del día" id="g-d-ind">
        <documentation>Soporte: mira el resultado del día. No suelta el vuelo y no publica cero.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Identidad T40/T50" id="g-d-id">
        <documentation>Genérico: número, modelo y serial. Se construye pequeño y lo comparten todos.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Compras y facturación" id="g-d-siigo">
        <documentation>Genérico: se resuelve con Siigo, que ya se compró.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Telemetría del equipo" id="g-d-agras">
        <documentation>Genérico: la da la app del fabricante.</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Ubicación del equipo" id="g-d-fh">
        <documentation>Genérico: FlightHub, de operaciones.</documentation>
      </element>
    </folder>
    <folder name="V6 Límites de agregado" id="id-fld-other-27">
      <element xsi:type="archimate:Grouping" name="Agregado «Disponibilidad del dron»" id="g-agg-do-disp"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Lista de las cinco»" id="g-agg-do-lista"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Orden de trabajo»" id="g-agg-do-ot"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Total de horas»" id="g-agg-do-horas"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Batería»" id="g-agg-do-bat"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Observación de las cinco»" id="g-agg-do-ind"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Retención»" id="g-agg-do-ret"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Pedido de repuesto»" id="g-agg-do-ped"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Despiece del dron»" id="g-agg-do-despiece"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Plan del dron»" id="g-agg-do-plan"/>
      <element xsi:type="archimate:Grouping" name="Agregado «Dron»" id="g-agg-do-dron"/>
    </folder>
    <folder name="V7 Lenguaje ubicuo" id="id-fld-other-28">
      <element xsi:type="archimate:Grouping" name="Lo que significa en otro oficio" id="g-v7-otro"/>
      <element xsi:type="archimate:Grouping" name="Lo que significa en el software del taller" id="g-v7-taller"/>
    </folder>
    <folder name="V9 Sistemas externos" id="id-fld-other-29">
      <element xsi:type="archimate:Grouping" name="Caminos separados: no se integran" id="g-sin">
        <documentation>Con estos no se intercambia nada. El taller no los consulta ni les escribe.</documentation>
      </element>
    </folder>
  </folder>
