          <child xsi:type="archimate:DiagramObject" id="id-v6f-n009" targetConnections="id-v6f-c010" fillColor="#c4e6ff" archimateElement="do-ret-carpeta">
            <feature name="labelExpression" value="«${specialization}»&#xA;${name}"/>
            <bounds x="388" y="134" width="170" height="58"/>
