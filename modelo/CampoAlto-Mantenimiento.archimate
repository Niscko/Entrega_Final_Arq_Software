      <element xsi:type="archimate:BusinessObject" name="Batería" id="bo-bat"/>
      <element xsi:type="archimate:BusinessObject" name="Retención" id="bo-ret"/>
      <element xsi:type="archimate:BusinessObject" name="Pedido de repuesto" id="bo-ped"/>
      <element xsi:type="archimate:BusinessObject" name="Observación de las cinco" id="bo-ind"/>
      <element xsi:type="archimate:BusinessObject" name="Dron: número, modelo y serial" id="bo-dron"/>
      <element xsi:type="archimate:BusinessObject" name="Factura de compra" id="bo-factura"/>
      <element xsi:type="archimate:BusinessObject" name="Lectura del control remoto" id="bo-lectura"/>
      <element xsi:type="archimate:BusinessObject" name="Ubicación del equipo" id="bo-ubicacion"/>
    </folder>
    <folder name="V7 Lenguaje ubicuo" id="id-fld-business-23">
      <element xsi:type="archimate:Representation" name="«Disponible»" id="rp-disponible"/>
