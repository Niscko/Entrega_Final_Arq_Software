      </element>
      <element xsi:type="archimate:BusinessService" name="Programar la finca" id="x-finca">
        <documentation>Lo hace el coordinador. A él le basta número, si sale y el límite.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Facturar hectáreas" id="x-fact">
        <documentation>Comercial, en Siigo, después del vuelo. La factura no suelta el dron.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar FlightHub" id="x-fh">
        <documentation>Operaciones mira la ubicación. El taller no lo usa para horas ni disponibilidad.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Radicar en el portal" id="x-port">
        <documentation>Cerrar la orden no radica nada. Seguridad arma el envío, aparte.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Revisar dosis e ICA" id="x-ica">
        <documentation>La dosis la pone el agrónomo. No entra al verde.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar habilitación" id="x-hab">
        <documentation>No existe ese registro. El alcance es el puesto.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Existencia automática" id="x-stock">
        <documentation>La existencia se ve en la estantería o la dice la base. Siigo no la devuelve.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Actualizar firmware" id="x-fw">
        <documentation>Lo hace el técnico de electrónica si el jefe lo autorizó.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Abrir la garantía" id="x-gar">
        <documentation>El preventivo no abre la garantía. El trámite no suelta el vuelo.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Baja automática de batería" id="x-baja">
        <documentation>A los 500 ciclos se propone. La baja la firma el jefe.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Cruzar pieza T40/T50" id="x-cruce">
        <documentation>El repuesto no se cruza. El T50 no sale con una sola bomba.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Hacer el pre-vuelo" id="x-pre">
        <documentation>Es de la madrugada, ya asignado. Si falla lo crítico, el dron vuelve a orden.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Recibir drones de afuera" id="x-ajeno">
        <documentation>Comercial dice que no. Registro, póliza y repuesto son de estos 24.</documentation>
        <property key="Capa" value="No se implementa"/>
      </element>
    </folder>
    <folder name="V4 Contratos" id="id-fld-business-8">
      <element xsi:type="archimate:Contract" name="Contrato · Cierre de jornada" id="ct-bs-cierre">
        <property key="Entra" value="Número del dron, horas de la pantalla o de la app, novedad y foto si hay"/>
        <property key="Sale" value="Verde, o en OT con la orden abierta"/>
        <property key="Error" value="App con menos horas por misión sin cerrar: se queda la hoja y se avisa al piloto"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Mantenimiento por subsistema" id="ct-bs-mant">
        <property key="Entra" value="Orden abierta con su motivo de entrada"/>
        <property key="Sale" value="Líneas firmadas; cierre de línea o cierre crítico"/>
        <property key="Error" value="Sin papel ni foto, el servicio se vuelve a hacer"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Liberación del vuelo" id="ct-bs-lib">
        <property key="Entra" value="Cierre crítico, horas al día, dos baterías sanas y ningún freno"/>
        <property key="Sale" value="Verde, sale condicionado con límite, o se queda con el motivo"/>
        <property key="Error" value="Sin respuesta del jefe, el dron se queda en tierra"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Publicación de la disponibilidad" id="ct-bs-pub">
        <property key="Entra" value="Estado de los 24 drones al corte de las 17:00"/>
        <property key="Sale" value="Lista: número, si sale, límite o motivo"/>
        <property key="Error" value="Lo que queda en verde después del corte no entra solo a la madrugada"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de horas de vuelo" id="ct-ds-horas">
        <property key="Entra" value="Lectura de pantalla, lectura de la app o mensaje del piloto"/>
        <property key="Sale" value="Un solo total por dron y horas desde la última 50"/>
        <property key="Error" value="Mensaje del piloto con pantalla ya leída: no se suma"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión del plan y el despiece" id="ct-ds-plan">
        <property key="Entra" value="Total de horas, fecha de la última visita de motor y despiece del modelo"/>
        <property key="Sale" value="Revisión de 50 h o visita de motor vencida, con la pieza que toca"/>
        <property key="Error" value="Pieza de otro modelo: se rechaza"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de órdenes de trabajo" id="ct-ds-ot">
        <property key="Entra" value="Motivo de entrada, hallazgo, pieza y serial que sale y que entra"/>
        <property key="Sale" value="La misma orden, con cada línea firmada"/>
        <property key="Error" value="Firma fuera del subsistema del técnico: no se acepta"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de baterías" id="ct-ds-bat">
        <property key="Entra" value="Alerta de la app, hinchazón, ciclos y rendimiento"/>
        <property key="Sale" value="Sana, apartada, a media carga, baja propuesta o baja firmada"/>
        <property key="Error" value="Baja sin firma del jefe: queda propuesta"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de la disponibilidad" id="ct-ds-disp">
        <property key="Entra" value="Cierres, horas, plan, baterías sanas y frenos"/>
        <property key="Sale" value="Estado: en OT, pendiente de visto bueno, verde, condicionado o frenado"/>
        <property key="Error" value="Orden crítica abierta: no pasa a verde"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de retenciones" id="ct-ds-ret">
        <property key="Entra" value="Mensaje de seguridad o boletín con seriales"/>
        <property key="Sale" value="Dron frenado, o boletín dejado para la próxima 50"/>
        <property key="Error" value="Comentario de otro operador: no frena la flota"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Gestión de pedidos de repuesto" id="ct-ds-ped">
        <property key="Entra" value="Pieza por nombre y modelo"/>
        <property key="Sale" value="Pedido con aviso de llegada y costo si lo pasan"/>
        <property key="Error" value="Pieza que no llegó: el dron sigue en orden"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Indicadores del día" id="ct-ds-ind">
        <property key="Entra" value="Lista, lotes corridos, fallos de pre-vuelo, espera de Bogotá y costo"/>
        <property key="Sale" value="Observación del día"/>
        <property key="Error" value="Dato que falta: el indicador queda vacío, nunca en cero"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Consultar órdenes críticas abiertas" id="ct-dfs-criticas">
        <property key="Entra" value="Número del dron"/>
        <property key="Sale" value="Órdenes abiertas de motor, bomba, batería o electrónica"/>
        <property key="Error" value="Dron sin número en Identidad: se rechaza"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Registrar el visto bueno" id="ct-dfs-visto">
        <property key="Entra" value="Número del dron y mensaje del jefe"/>
        <property key="Sale" value="Visto bueno con quién y cuándo"/>
        <property key="Error" value="Visto bueno de alguien que no es el jefe: no se registra"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Marcar sale condicionado" id="ct-dfs-cond">
        <property key="Entra" value="Número y límite escrito por el jefe"/>
        <property key="Sale" value="Sale condicionado con su límite"/>
        <property key="Error" value="Daño que toca hélice o tanque: no puede ser condicionado"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Verificar dos baterías sanas" id="ct-dfs-bat">
        <property key="Entra" value="Número y modelo del dron"/>
        <property key="Sale" value="Baterías sanas del modelo en la base"/>
        <property key="Error" value="Menos de dos: no entra a la lista"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Cortar la lista de las cinco" id="ct-dfs-corte">
        <property key="Entra" value="Estado de cada dron a las 17:00"/>
        <property key="Sale" value="Renglones de la lista"/>
        <property key="Error" value="Lo que se cierra después del corte no se mete solo"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Devolver a orden por pre-vuelo" id="ct-dfs-prevuelo">
        <property key="Entra" value="Número y falla del pre-vuelo"/>
        <property key="Sale" value="Dron devuelto a orden"/>
        <property key="Error" value="Hélice o boquilla del kit: se resuelve sin volver a orden"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Traducir la lectura del Agras" id="ct-acs-agras">
        <property key="Dirección" value="App del Agras → Horas y Baterías"/>
        <property key="Frecuencia" value="Diario, cuando alguien lee la pantalla"/>
        <property key="Entra" value="Horas del equipo, caudal, alerta de batería y ciclos"/>
        <property key="Sale" value="Lectura con número de dron y hora"/>
        <property key="Error" value="No se copia sola: sin lectura no hay dato"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir la novedad de campo" id="ct-acs-novedad">
        <property key="Dirección" value="«Novedades campo» → Intervención y Horas"/>
        <property key="Frecuencia" value="Diario, los días que se vuela"/>
        <property key="Entra" value="Número, qué pasó, foto; horas y baterías si el piloto se acuerda"/>
        <property key="Sale" value="Síntoma para la orden; horas del mensaje sin sumar"/>
        <property key="Error" value="Mensaje sin número de dron: no se asigna"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el recuento del lunes" id="ct-acs-recuento">
        <property key="Dirección" value="Buga y Espinal → Baterías"/>
        <property key="Frecuencia" value="Semanal, el lunes"/>
        <property key="Entra" value="Foto de la pantalla de las baterías que fallaron"/>
        <property key="Sale" value="Ciclos y alertas de la semana"/>
        <property key="Error" value="Foto sin serial: se pide otra"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Entregar la lista a operaciones" id="ct-acs-lista">
        <property key="Dirección" value="Soltar el vuelo → grupo «Programa»"/>
        <property key="Frecuencia" value="Diario, antes de las 17:00"/>
        <property key="Entra" value="Lista del corte"/>
        <property key="Sale" value="Número, si sale, límite o motivo"/>
        <property key="Error" value="Sin despiece, sin regla de 50 h y sin póliza"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el lote corrido" id="ct-acs-lote">
        <property key="Dirección" value="Grupo «Programa» → Indicadores"/>
        <property key="Frecuencia" value="Diario"/>
        <property key="Entra" value="Lote corrido y su causa"/>
        <property key="Sale" value="Lote corrido por el taller"/>
        <property key="Error" value="Corrido porque el cliente no tuvo el químico: no cuenta"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Pedir la pieza al distribuidor" id="ct-acs-pedir">
        <property key="Dirección" value="Pedido → distribuidor de Bogotá"/>
        <property key="Frecuencia" value="Eventual"/>
        <property key="Entra" value="Pieza por nombre y modelo"/>
        <property key="Sale" value="Pedido por WhatsApp o correo; número de parte de la pieza vieja si lo piden"/>
        <property key="Error" value="Sin código de bodega"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el aviso de llegada" id="ct-acs-llegada">
        <property key="Dirección" value="Distribuidor o la base → Pedido"/>
        <property key="Frecuencia" value="Eventual"/>
        <property key="Entra" value="Fecha prometida, a veces; aviso cuando el paquete entra"/>
        <property key="Sale" value="Llegada registrada"/>
        <property key="Error" value="La fecha prometida no suelta el dron"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el costo de Siigo" id="ct-acs-costo">
        <property key="Dirección" value="Siigo (administración) → Pedido"/>
        <property key="Frecuencia" value="Eventual, si se pide"/>
        <property key="Entra" value="Costo de la factura de compra"/>
        <property key="Sale" value="Costo al lado del pedido"/>
        <property key="Error" value="Si no lo pasan, queda vacío"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el boletín del fabricante" id="ct-acs-boletin">
        <property key="Dirección" value="Distribuidor → Retención"/>
        <property key="Frecuencia" value="Eventual"/>
        <property key="Entra" value="Lote de bombas, rango de seriales o firmware"/>
        <property key="Sale" value="Seriales que coinciden con la flota y su alcance"/>
        <property key="Error" value="Comentario de otro operador: no es boletín"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Recibir el freno de seguridad" id="ct-acs-freno">
        <property key="Dirección" value="Seguridad y gerencia → Retención"/>
        <property key="Frecuencia" value="Eventual"/>
        <property key="Entra" value="«Este dron no sale»: registro, póliza o incidente"/>
        <property key="Sale" value="Dron frenado"/>
        <property key="Error" value="El mensaje no se reinterpreta"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Entregar la carpeta a seguridad" id="ct-acs-carpeta">
        <property key="Dirección" value="Retención → seguridad"/>
        <property key="Frecuencia" value="Una vez al año, auditoría o incidente"/>
        <property key="Entra" value="Pedido de seguridad"/>
        <property key="Sale" value="Carpeta: fecha, dron, horas, qué se cambió, quién firmó"/>
        <property key="Error" value="Servicio sin papel ni foto: no se inventa"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Entregar la última probeta" id="ct-acs-probeta">
        <property key="Dirección" value="Intervención → operaciones"/>
        <property key="Frecuencia" value="Eventual, si reclaman la dosis"/>
        <property key="Entra" value="Número del dron"/>
        <property key="Sale" value="Última prueba de caudal de la orden"/>
        <property key="Error" value="No se entrega el historial del taller"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Maestro de drones" id="ct-bds-drones">
        <property key="Entra" value="Número"/>
        <property key="Sale" value="Modelo, serial y fecha de entrega"/>
        <property key="Error" value="Dron que no es de la flota: no existe"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Despiece por modelo" id="ct-bds-despiece">
        <property key="Entra" value="Modelo"/>
        <property key="Sale" value="Subsistemas, piezas y su condición: horas, ciclos, calendario o estado"/>
        <property key="Error" value="Pieza de otro modelo: se rechaza"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Catálogo de repuestos por modelo" id="ct-bds-repuestos">
        <property key="Entra" value="Pieza y modelo"/>
        <property key="Sale" value="Nombre para pedir y si va de a par"/>
        <property key="Error" value="Sin código de bodega"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Puestos y alcance por subsistema" id="ct-bds-puestos">
        <property key="Entra" value="Técnico"/>
        <property key="Sale" value="Subsistemas que puede firmar y su base"/>
        <property key="Error" value="El de línea no firma motor, baja ni electrónica"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Bases y ubicación del dron" id="ct-bds-bases">
        <property key="Entra" value="Número del dron"/>
        <property key="Sale" value="Base donde duerme: Palmira, Buga o Espinal"/>
        <property key="Error" value="Espinal cerrada fuera de campaña"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Identidad y permisos por puesto" id="ct-is-permisos">
        <property key="Entra" value="Usuario y acción"/>
        <property key="Sale" value="Permitido o no según el puesto"/>
        <property key="Error" value="Visto bueno de alguien que no es el jefe: se niega"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Avisos a los grupos" id="ct-is-avisos">
        <property key="Entra" value="Mensaje y grupo"/>
        <property key="Sale" value="Aviso enviado"/>
        <property key="Error" value="Sin señal: queda pendiente"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Auditoría de cambios de estado" id="ct-is-auditoria">
        <property key="Entra" value="Cambio de estado"/>
        <property key="Sale" value="Quién, cuándo y por qué"/>
        <property key="Error" value="Un cambio no se borra"/>
      </element>
      <element xsi:type="archimate:Contract" name="Contrato · Fotos y documentos de la orden" id="ct-is-documental">
        <property key="Entra" value="Foto del papel"/>
        <property key="Sale" value="Foto adjunta a la orden"/>
        <property key="Error" value="Sin señal en Espinal: la foto sube después"/>
      </element>
    </folder>
    <folder name="V4 Objetos del negocio" id="id-fld-business-9">
      <element xsi:type="archimate:BusinessObject" name="Disponibilidad del dron" id="bo-disp"/>
      <element xsi:type="archimate:BusinessObject" name="Lista de las cinco" id="bo-lista"/>
